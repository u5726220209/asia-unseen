---
import Logo from './Logo.astro';
import Search from './Search.astro';
import { paysNav, guidesNav, mainNav } from '@/data/nav';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<header class="sticky top-0 z-50 border-b border-line/80 bg-cream/85 backdrop-blur-md">
  <div class="wrap flex h-[4.25rem] items-center justify-between gap-6">
    <a href="/" class="shrink-0" aria-label="Asia Unseen, accueil"><Logo /></a>

    <!-- Navigation principale (desktop) -->
    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigation principale">
      <details class="au-menu group relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-brand px-3 py-2 font-display text-[0.9rem] font-medium text-ink transition-colors hover:text-teal"
        >
          Pays
          <svg viewBox="0 0 12 12" class="h-3 w-3 transition-transform group-open:rotate-180" aria-hidden="true"
            ><path d="M2 4.5 6 8.5 10 4.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg
          >
        </summary>
        <div class="absolute left-0 top-full w-[34rem] pt-2">
          <div class="grid grid-cols-2 gap-1 rounded-brand border border-line bg-white p-3 shadow-lift-hover">
            {paysNav.map((item) => (
              <a href={item.href} class="rounded-brand px-3 py-2.5 transition-colors hover:bg-teal-50">
                <span class="block font-display text-[0.9rem] font-semibold text-ink">{item.label}</span>
                <span class="block text-[0.78rem] leading-snug text-warm">{item.hint}</span>
              </a>
            ))}
          </div>
        </div>
      </details>

      <details class="au-menu group relative">
        <summary
          class="flex cursor-pointer list-none items-center gap-1.5 rounded-brand px-3 py-2 font-display text-[0.9rem] font-medium text-ink transition-colors hover:text-teal"
        >
          Guides
          <svg viewBox="0 0 12 12" class="h-3 w-3 transition-transform group-open:rotate-180" aria-hidden="true"
            ><path d="M2 4.5 6 8.5 10 4.5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg
          >
        </summary>
        <div class="absolute left-1/2 top-full w-[36rem] -translate-x-1/2 pt-2">
          <div class="grid grid-cols-2 gap-1 rounded-brand border border-line bg-white p-3 shadow-lift-hover">
            {guidesNav.map((item) => (
              <a href={item.href} class="rounded-brand px-3 py-2.5 transition-colors hover:bg-teal-50">
                <span class="block font-display text-[0.9rem] font-semibold text-ink">{item.label}</span>
                <span class="block text-[0.78rem] leading-snug text-warm">{item.hint}</span>
              </a>
            ))}
          </div>
        </div>
      </details>

      {mainNav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-brand px-3 py-2 font-display text-[0.9rem] font-medium transition-colors hover:text-teal',
            isActive(item.href) ? 'text-teal' : 'text-ink',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a
        >
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <Search />
      <a href="/newsletter" class="btn-primary hidden !px-5 !py-2.5 !text-[0.85rem] sm:inline-flex">
        Recevoir les fiches
      </a>
      <button
        type="button"
        id="au-burger"
        class="-mr-2 inline-flex h-10 w-10 items-center justify-center rounded-brand text-ink lg:hidden"
        aria-label="Ouvrir le menu"
        aria-expanded="false"
        aria-controls="au-mobile"
      >
        <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Panneau mobile -->
  <div id="au-mobile" hidden class="border-t border-line bg-cream lg:hidden">
    <nav class="wrap max-h-[75vh] overflow-y-auto py-6" aria-label="Navigation mobile">
      <p class="eyebrow mb-3">Destinations</p>
      <ul class="mb-8 grid grid-cols-2 gap-x-4 gap-y-1">
        {paysNav.map((i) => (
          <li><a href={i.href} class="block py-2 font-display text-[0.95rem] font-medium">{i.label}</a></li>
        ))}
      </ul>
      <p class="eyebrow mb-3">Guides pratiques</p>
      <ul class="mb-8 grid gap-1">
        {guidesNav.map((i) => (
          <li><a href={i.href} class="block py-2 font-display text-[0.95rem] font-medium">{i.label}</a></li>
        ))}
      </ul>
      <ul class="mb-8 grid gap-1 border-t border-line pt-6">
        {mainNav.map((i) => (
          <li><a href={i.href} class="block py-2 font-display text-[0.95rem] font-medium">{i.label}</a></li>
        ))}
      </ul>
      <a href="/newsletter" class="btn-primary w-full">Recevoir les fiches de départ</a>
    </nav>
  </div>
</header>

<script>
  // Menus déroulants : un seul ouvert à la fois, fermeture au clic extérieur et à Échap.
  const menus = Array.from(document.querySelectorAll<HTMLDetailsElement>('details.au-menu'));
  menus.forEach((menu) => {
    menu.addEventListener('toggle', () => {
      if (menu.open) menus.filter((m) => m !== menu).forEach((m) => (m.open = false));
    });
  });
  document.addEventListener('click', (e) => {
    if (!(e.target instanceof Node)) return;
    menus.forEach((m) => { if (m.open && !m.contains(e.target as Node)) m.open = false; });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') menus.forEach((m) => (m.open = false));
  });

  // Panneau mobile
  const burger = document.getElementById('au-burger');
  const panel = document.getElementById('au-mobile');
  burger?.addEventListener('click', () => {
    const open = burger.getAttribute('aria-expanded') === 'true';
    burger.setAttribute('aria-expanded', String(!open));
    burger.setAttribute('aria-label', open ? 'Ouvrir le menu' : 'Fermer le menu');
    if (panel) panel.hidden = open;
  });
</script>
