---
/**
 * « Horizons » — système d'illustration génératif.
 *
 * Le site n'a pas de photographies, et la charte interdit les images de stock
 * génériques (coucher de soleil saturé, temple vide au grand-angle). Plutôt
 * qu'un remplissage acheté au kilo, chaque page reçoit une illustration
 * dessinée par le site lui-même.
 *
 * Le langage graphique prolonge le symbole : le mark est fait de traits
 * rectilignes, les crêtes le sont donc aussi. Aucune courbe, aucun dégradé,
 * aucune texture — trois familles de couleur au maximum, comme partout.
 *
 * La composition est déterministe : la même graine produit toujours la même
 * image. Chaque page a donc la sienne, stable d'une publication à l'autre,
 * et deux pages ne se ressemblent jamais tout à fait.
 */

interface Props {
  /** Graine : le slug de la page suffit. Détermine entièrement la composition. */
  seed: string;
  variant?: 'hero' | 'bande';
  /** Famille chromatique des crêtes. */
  accent?: 'teal' | 'ink';
  /** Fond sombre — pour les sections encre. */
  invert?: boolean;
  class?: string;
}

const { seed, variant = 'hero', accent = 'teal', invert = false, class: klass = '' } = Astro.props;

/* ── Générateur déterministe ──────────────────────────────── */

function hash(s: string): number {
  let h = 2166136261;
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 16777619);
  }
  return h >>> 0;
}

function rng(graine: number) {
  let a = graine;
  return () => {
    a |= 0;
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const W = 1200;
const H = variant === 'hero' ? 340 : 150;
const r = rng(hash(seed));

/**
 * Une crête : des sommets à intervalles réguliers, reliés en ligne droite,
 * refermés sur le bas du cadre. `amp` règle l'altitude, `pas` la nervosité.
 */
function crete(baseY: number, amp: number, pas: number, biais = 0.12): string {
  const pts: string[] = [`M -20 ${H + 20}`, `L -20 ${baseY}`];
  for (let x = -20; x <= W + 20; x += pas) {
    const y = baseY - amp * (biais + (1 - biais) * r());
    pts.push(`L ${x.toFixed(0)} ${y.toFixed(1)}`);
  }
  pts.push(`L ${W + 20} ${H + 20}`, 'Z');
  return pts.join(' ');
}

/* ── Palettes ─────────────────────────────────────────────── */

const PALETTES = {
  teal: ['#D3F4EE', '#A9E9DF', '#34B3A3', '#0F766E', '#07403C'],
  ink: ['#E5E7EB', '#B9BEC5', '#6B7280', '#2E3238', '#0A0A0A'],
} as const;

const teintes = PALETTES[accent];
const ciel = invert ? '#0A0A0A' : '#F5F3EF';

// Quatre plans, du plus lointain au plus proche : chaque plan est plus haut,
// plus sombre et plus nerveux que le précédent.
const plans = (variant === 'hero'
  ? [
      { base: H * 0.66, amp: H * 0.46, pas: 190, t: 0 },
      { base: H * 0.78, amp: H * 0.50, pas: 135, t: 1 },
      { base: H * 0.90, amp: H * 0.44, pas: 95, t: 2 },
      { base: H * 1.04, amp: H * 0.38, pas: 62, t: 3 },
    ]
  : [
      { base: H * 0.74, amp: H * 0.56, pas: 150, t: 1 },
      { base: H * 1.00, amp: H * 0.50, pas: 82, t: 3 },
    ]
).map((p) => ({ ...p, d: crete(p.base, p.amp, p.pas) }));

// Le disque : toujours dans le tiers haut, décalé selon la graine. Il passe
// derrière la première crête, ce qui donne la profondeur sans dégradé.
const discX = 180 + r() * (W - 360);
const discY = H * (variant === 'hero' ? 0.30 : 0.34);
const discR = variant === 'hero' ? 38 : 22;

// Deux ou trois bandes de brume, alignées sur la grille horizontale.
const brumes = Array.from({ length: variant === 'hero' ? 3 : 2 }, (_, i) => ({
  y: H * (0.42 + i * 0.09),
  x: 40 + r() * (W * 0.4),
  w: W * (0.22 + r() * 0.3),
}));

const id = `hz-${hash(seed + variant).toString(36)}`;
---

<svg
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  class:list={['block h-full w-full', klass]}
>
  <clipPath id={id}><rect width={W} height={H} /></clipPath>
  <g clip-path={`url(#${id})`}>
    <rect width={W} height={H} fill={ciel} />

    <circle cx={discX} cy={discY} r={discR} fill="#F59E0B" />

    {brumes.map((b) => (
      <rect x={b.x} y={b.y} width={b.w} height="2" fill={invert ? '#FFFFFF' : '#0A0A0A'} opacity="0.07" />
    ))}

    {plans.map((p) => <path d={p.d} fill={teintes[p.t]} />)}
  </g>
</svg>
