---
import Newsletter from './Newsletter.astro';
---

<div
  id="au-exit"
  hidden
  class="fixed inset-0 z-[90] hidden items-center justify-center bg-ink/70 p-4 backdrop-blur-sm"
  role="dialog"
  aria-modal="true"
  aria-labelledby="au-exit-title"
>
  <div class="relative w-full max-w-lg rounded-brand bg-cream p-8 shadow-lift-hover sm:p-10">
    <button
      type="button" id="au-exit-close"
      class="absolute right-4 top-4 inline-flex h-9 w-9 items-center justify-center rounded-brand text-warm transition-colors hover:bg-line hover:text-ink"
      aria-label="Fermer"
    >
      <svg viewBox="0 0 16 16" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" aria-hidden="true">
        <path d="M4 4l8 8M12 4l-8 8" />
      </svg>
    </button>

    <p class="eyebrow">Avant de partir</p>
    <h2 id="au-exit-title" class="mt-2 font-display text-2xl font-bold leading-tight text-ink">
      Emportez nos 5 itinéraires Asie
    </h2>
    <p class="mt-3 text-[0.95rem] leading-relaxed text-warm">
      Vietnam en 10 jours, Japon en 2 semaines, boucle Thaïlande–Laos, tour de Corée,
      3 semaines en Asie du Sud-Est. Budgets réels, trajets, adresses. Gratuit, en un email.
    </p>
    <Newsletter variant="compact" class="mt-6 [&_input]:!border-ink/15 [&_input]:!bg-white [&_input]:!text-ink [&_input]:placeholder:!text-warm-light" />
    <button type="button" id="au-exit-no" class="mt-4 text-[0.82rem] text-warm-light underline underline-offset-4 hover:text-warm">
      Non merci, je préfère chercher moi-même
    </button>
  </div>
</div>

<script>
  // Pop-up d'intention de sortie.
  //  · une seule fois par visiteur (mémorisé 60 jours)
  //  · desktop : sortie du curseur par le haut ; mobile : après 60 % de scroll
  //  · jamais avant 20 secondes de lecture, pour ne pas casser l'expérience
  const KEY = 'au_exit_seen';
  const modal = document.getElementById('au-exit');

  function seen(): boolean {
    try {
      const v = localStorage.getItem(KEY);
      return !!v && Date.now() - Number(v) < 60 * 24 * 3600 * 1000;
    } catch { return true; }
  }
  function remember() {
    try { localStorage.setItem(KEY, String(Date.now())); } catch { /* mode privé */ }
  }
  function close() {
    if (!modal) return;
    modal.hidden = true;
    modal.classList.replace('flex', 'hidden');
    remember();
  }
  function open() {
    if (!modal || modal.hidden === false || seen()) return;
    modal.hidden = false;
    modal.classList.replace('hidden', 'flex');
    modal.querySelector<HTMLInputElement>('input[type=email]')?.focus();
  }

  if (modal && !seen()) {
    let armed = false;
    setTimeout(() => { armed = true; }, 20_000);

    document.addEventListener('mouseout', (e) => {
      if (armed && !e.relatedTarget && (e as MouseEvent).clientY <= 0) open();
    });

    let fired = false;
    addEventListener('scroll', () => {
      if (fired || !armed) return;
      const ratio = scrollY / (document.body.scrollHeight - innerHeight || 1);
      if (ratio > 0.6) { fired = true; open(); }
    }, { passive: true });

    document.getElementById('au-exit-close')?.addEventListener('click', close);
    document.getElementById('au-exit-no')?.addEventListener('click', close);
    modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !modal.hidden) close(); });
  }
</script>
