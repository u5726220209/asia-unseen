---
import { buildUrl, partners, type PartnerKey } from '@/data/affiliates';

/**
 * Lien d'affiliation. Applique systématiquement rel="sponsored nofollow noopener"
 * (exigence Google) et ouvre dans un nouvel onglet, pour ne pas faire perdre
 * sa lecture à l'utilisateur.
 */
interface Props {
  partner: PartnerKey;
  params?: Record<string, string>;
  path?: string;      // chemin de destination chez le partenaire, tracking conservé
  href?: string;      // pour surcharger l'URL générée (page produit précise) — sans tracking
  variant?: 'button' | 'text';
  /**
   * La langue de la mention lue par les lecteurs d'écran.
   *
   * « (lien partenaire, s'ouvre dans un nouvel onglet) » est en `sr-only` :
   * invisible, donc jamais relu, et pourtant c'est la divulgation elle-même.
   * Sur une page anglaise, elle était annoncée en français dans une voix
   * anglaise — c'est-à-dire que la seule personne à qui la divulgation était
   * réservée était aussi la seule à ne pas la comprendre.
   */
  langue?: 'fr' | 'en';
  class?: string;
}
const { partner, params = {}, path, href, variant = 'button', langue = 'fr', class: klass = '' } = Astro.props;
const url = href ?? buildUrl(partner, params, path, langue);
const label = partners[partner].label;
---

<a
  href={url}
  rel="sponsored nofollow noopener"
  target="_blank"
  data-aff={partner}
  class:list={[variant === 'button' ? 'btn-primary' : 'link', klass]}
>
  <slot>Voir sur {label}</slot>
  {variant === 'button' && (
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 3h7v7M13 3 3.5 12.5" />
    </svg>
  )}
  <span class="sr-only">
    {langue === 'en'
      ? '(affiliate link, opens in a new tab)'
      : "(lien partenaire, s'ouvre dans un nouvel onglet)"}
  </span>
</a>
