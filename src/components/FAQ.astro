---
/**
 * FAQ dépliante + balisage FAQPage.
 * Les questions-réponses sont volontairement rédigées « answer-first » :
 * la première phrase répond, le reste développe. C'est ce format que
 * reprennent les extraits enrichis et les réponses génératives.
 */
interface Props {
  items: { q: string; r: string }[];
  title?: string;
  schema?: boolean;
}
const { items, title = 'Questions fréquentes', schema = true } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.r },
  })),
};
---

{items.length > 0 && (
  <section class="mt-16">
    <h2 class="text-title">{title}</h2>
    <div class="mt-4 h-[3px] w-12 bg-amber"></div>
    <div class="mt-8 divide-y divide-line border-y border-line">
      {items.map((item) => (
        <details class="group py-1">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 font-display text-[1.02rem] font-semibold text-ink transition-colors hover:text-teal">
            {item.q}
            <svg viewBox="0 0 16 16" class="mt-1 h-4 w-4 shrink-0 text-teal transition-transform group-open:rotate-45" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
              <path d="M8 3v10M3 8h10" />
            </svg>
          </summary>
          <p class="pb-5 pr-10 text-[0.97rem] leading-relaxed text-ink-soft">{item.r}</p>
        </details>
      ))}
    </div>
    {schema && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </section>
)}
