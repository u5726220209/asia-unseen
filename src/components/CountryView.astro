---
import type { Country } from '@/data/countries';
import { MOIS } from '@/data/countries';
import Breadcrumbs from './Breadcrumbs.astro';
import Disclosure from './Disclosure.astro';
import VerifiedBadge from './VerifiedBadge.astro';
import RegleParPasseport from './RegleParPasseport.astro';
import AffiliateLink from './AffiliateLink.astro';
import Callout from './Callout.astro';
import FAQ from './FAQ.astro';
import AdSlot from './AdSlot.astro';
import Newsletter from './Newsletter.astro';
import VeillePersonnelle from './VeillePersonnelle.astro';
import Visuel from './Visuel.astro';
import ArticleCard from './ArticleCard.astro';
import VeillePays from './VeillePays.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  country: Country;
  related: { href: string; label: string; hint: string }[];
  /** Articles et guides portant ce pays dans leur frontmatter. */
  lies: { articles: CollectionEntry<'blog'>[]; guides: CollectionEntry<'guides'>[] };
}
const { country: c, related, lies } = Astro.props;

const fmtCourt = (d: Date) =>
  new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(d);

/* ── Les trois faits qui décident, remontés en tête de page ────── */

const moisIdeaux = c.saisons
  .map((s, i) => ({ s, m: MOIS[i] }))
  .filter((x) => x.s === 3)
  .map((x) => x.m);

const jourCourt = (iso: string) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short' }).format(new Date(`${iso}T00:00:00`));
const jourLong = (iso: string) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${iso}T00:00:00`));
const moisEnLettres = (aaaaMm: string) =>
  new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(new Date(`${aaaaMm}-01T00:00:00`));

/**
 * Une règle déjà publiée dont la date d'effet n'est pas encore arrivée.
 *
 * Deux nombres cohabitent ici, et ils se ressemblent assez pour être
 * intervertis sans que rien ne proteste : les jours qui restent avant la
 * bascule, et la durée de séjour qui s'appliquera après. La première version
 * de ce bandeau annonçait « 9 j dès le 15 sept. » — le compte à rebours à la
 * place de la règle. D'où ces deux noms, qu'on ne peut plus confondre.
 */
const bascule = c.visa.sansVisaJoursApres;
const jourISO = new Date().toISOString().slice(0, 10);
const basculeAVenir =
  bascule && bascule.date > jourISO
    ? {
        date: bascule.date,
        nouvelleDuree: bascule.jours,
        joursRestants: Math.ceil(
          (new Date(`${bascule.date}T00:00:00`).getTime() - new Date(`${jourISO}T00:00:00`).getTime()) / 86_400_000,
        ),
      }
    : null;

const SAISON_STYLE = {
  3: { cell: 'bg-teal text-cream', label: 'Idéal' },
  2: { cell: 'bg-amber-100 text-amber-700', label: 'Correct' },
  1: { cell: 'bg-cream-warm text-warm-light', label: 'À éviter' },
} as const;

const faq = [
  {
    q: `Faut-il un visa pour ${c.article === 'aux' ? 'aller aux' : c.article === 'au' ? 'aller au' : 'aller en'} ${c.nom} ?`,
    r: `${c.visa.resume} ${c.visa.duree} Coût : ${c.visa.cout}. ${c.visa.procedure} Ces règles évoluent : vérifiez sur le portail officiel avant de réserver.`,
  },
  {
    q: `Quel budget prévoir par jour ${c.article === 'aux' ? 'aux' : c.article} ${c.nom} ?`,
    r: `Comptez environ ${c.budget.routard} € par jour et par personne en voyage routard (dortoir, bus, cuisine de rue), ${c.budget.confort} € en voyage confort (hôtel 3★, restaurants, quelques trajets rapides) et ${c.budget.premium} € en voyage premium. Ces montants excluent le vol international, estimé à ${c.volDepuisParis.includes('escale') ? '700 à 800 €' : '620 à 780 €'} aller-retour depuis Paris.`,
  },
  {
    q: `Quelle est la meilleure période pour partir ${c.article === 'aux' ? 'aux' : c.article} ${c.nom} ?`,
    r: c.saisonNote,
  },
  {
    q: `Quelle est la principale erreur à éviter ${c.article === 'aux' ? 'aux' : c.article} ${c.nom} ?`,
    r: c.erreurs[0] + ". Les autres pièges fréquents sont détaillés dans la section « Ce qu'il ne faut pas faire » de ce guide.",
  },
];
---

<article>
  <!-- Hero -->
  <header class="border-b border-line bg-cream-warm">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs items={[{ href: '/#destinations', label: 'Destinations' }, { label: c.nom }]} />

      <h1 class="mt-6 max-w-3xl text-hero">Voyager {c.article === 'aux' ? 'aux' : c.article} {c.nom}</h1>
      <p class="mt-6 max-w-2xl text-[1.15rem] leading-relaxed text-warm">{c.resume}</p>
      <p class="mt-5 max-w-2xl text-[0.95rem] text-warm-light">
        <strong class="font-semibold text-ink-soft">Pour qui :</strong> {c.pourQui}
      </p>

      {/*
        Ce bandeau annonçait la capitale, la monnaie, le décalage horaire et la
        durée du vol. Quatre faits exacts, et pas un que quelqu'un cherche avant
        de réserver : personne n'arrive ici en se demandant quelle est la
        capitale de la Thaïlande. Pendant ce temps, les trois questions qui
        décident vraiment — puis-je entrer, quand partir, combien ça coûte —
        étaient à trois sections plus bas.

        Elles sont maintenant ici, chacune reliée à sa section. La quatrième
        cellule porte la date de vérification : sur une page de formalités,
        c'est le fait qui vaut le plus, et il ne servait à rien enterré.

        Les faits pratiques ne sont pas perdus : ils passent juste en dessous,
        à la place qu'ils méritent.
      */}
      <dl class="mt-10 grid gap-px overflow-hidden rounded-brand border border-line bg-line sm:grid-cols-2 lg:grid-cols-4">
        <a href="#visa" class="group bg-cream-warm px-5 py-4 transition hover:bg-white">
          <dt class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-warm-light">Entrée</dt>
          <dd class="mt-1 text-[0.92rem] font-medium text-ink group-hover:text-teal">
            {c.visa.sansVisaJours > 0 ? `${c.visa.sansVisaJours} jours sans visa` : 'Visa obligatoire'}
          </dd>
          {basculeAVenir && (
            <dd class="mt-1.5 inline-block rounded-full bg-amber-100 px-2 py-0.5 font-display text-[0.7rem] font-semibold text-amber-700">
              {basculeAVenir.nouvelleDuree} j dès le {jourCourt(basculeAVenir.date)}
            </dd>
          )}
        </a>
        <a href="#saison" class="group bg-cream-warm px-5 py-4 transition hover:bg-white">
          <dt class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-warm-light">Meilleurs mois</dt>
          <dd class="mt-1 text-[0.92rem] font-medium text-ink group-hover:text-teal">
            {moisIdeaux.length ? moisIdeaux.join(' · ') : 'Variable selon les régions'}
          </dd>
        </a>
        <a href="#budget" class="group bg-cream-warm px-5 py-4 transition hover:bg-white">
          <dt class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-warm-light">Budget</dt>
          <dd class="mt-1 text-[0.92rem] font-medium text-ink group-hover:text-teal">
            dès {c.budget.routard} € / jour
          </dd>
        </a>
        <div class="bg-cream-warm px-5 py-4">
          <dt class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.14em] text-warm-light">Formalités vérifiées</dt>
          <dd class="mt-1 text-[0.92rem] font-medium text-ink">{moisEnLettres(c.verifieLe)}</dd>
        </div>
      </dl>

      <p class="mt-4 text-[0.85rem] text-warm-light">
        {c.capitale} · {c.monnaie} · {c.decalage} · {c.volDepuisParis}
      </p>

      {/*
        Une règle publiée dont la date d'effet approche. C'est l'information la
        plus chère de la page — elle vaut un vol avancé de vingt-quatre heures
        ou trente jours de séjour — et elle vivait dans un paragraphe, au
        milieu de la section des formalités.
      */}
      {basculeAVenir && (
        <div class="mt-8 flex flex-wrap items-baseline gap-x-3 gap-y-1.5 rounded-brand border-l-[3px] border-amber bg-amber-50 px-5 py-4">
          <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-amber-700">
            Dans {basculeAVenir.joursRestants} jour{basculeAVenir.joursRestants > 1 ? 's' : ''}
          </p>
          <p class="text-[0.95rem] leading-relaxed text-ink-soft">
            L'exemption passe de <strong class="font-semibold text-ink">{c.visa.sansVisaJours}</strong> à
            <strong class="font-semibold text-ink"> {basculeAVenir.nouvelleDuree}</strong> jours pour toute entrée
            à partir du {jourLong(basculeAVenir.date)}.
            <a href="#visa" class="ml-1 font-semibold text-amber-700 underline decoration-amber/40 underline-offset-4">
              Ce que ça change selon votre date
            </a>
          </p>
        </div>
      )}
    </div>
  </header>

  <Visuel page={`/${c.slug}`} seed={c.slug} accent={c.accent === 'ink' ? 'ink' : 'teal'} prioritaire />

  <div class="wrap grid gap-14 py-14 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
    <div class="prose-au min-w-0">
      <Disclosure class="!mb-10 !mt-0" />

      <!-- Budget -->
      <h2 id="budget">Quel budget prévoir</h2>
      <p>
        Trois façons de voyager {c.article === 'aux' ? 'aux' : c.article} {c.nom}, trois budgets très différents.
        Les montants ci-dessous sont par personne et par jour, hors vol international, hors assurance
        et hors achats personnels.
      </p>

      <div class="not-prose my-8 grid gap-px overflow-hidden rounded-brand border border-line bg-line sm:grid-cols-3">
        {[
          ['Routard', c.budget.routard, 'Dortoir ou guesthouse, bus de nuit, cuisine de rue, peu d\'activités payantes.'],
          ['Confort', c.budget.confort, 'Hôtel 3★ ou bel Airbnb, restaurants, trajets rapides, visites guidées.'],
          ['Premium', c.budget.premium, 'Hôtel 4★, chauffeur privé, excursions organisées, vols intérieurs.'],
        ].map(([label, montant, desc], i) => (
          <div class:list={['bg-white p-6', i === 1 && 'ring-1 ring-inset ring-teal-200']}>
            <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-warm-light">{label}</p>
            <p class="mt-2 font-display text-[2.1rem] font-bold leading-none tracking-tight text-ink">
              {montant} <span class="text-[1.1rem] font-semibold text-warm">€ / jour</span>
            </p>
            <p class="mt-3 text-[0.85rem] leading-relaxed text-warm">{desc}</p>
          </div>
        ))}
      </div>

      <p>
        Pour appliquer ces fourchettes à votre itinéraire réel — durée, nombre de voyageurs,
        vol inclus ou non — la page <a href={`/budget/${c.slug}`}>budget {c.nom}</a> fait le
        calcul et situe le pays par rapport à ses voisins. Le
        <a href="/budget-voyage-asie">guide du budget en Asie</a> détaille ce que recouvre
        chaque poste.
      </p>

      <AdSlot placement="in-article" />

      <!-- Saison -->
      <h2 id="saison">Quand partir</h2>
      <div class="not-prose my-8 overflow-hidden rounded-brand border border-line bg-white">
        <div class="table-wrap !my-0">
          <div class="grid min-w-[34rem] grid-cols-12">
            {c.saisons.map((s, i) => (
              <div class="border-r border-line/60 last:border-r-0">
                <p class="border-b border-line py-2 text-center font-display text-[0.72rem] font-semibold uppercase tracking-wider text-warm">
                  {MOIS[i]}
                </p>
                <p class:list={['py-4 text-center font-display text-[0.68rem] font-semibold uppercase tracking-wide', SAISON_STYLE[s].cell]}>
                  {SAISON_STYLE[s].label}
                </p>
              </div>
            ))}
          </div>
        </div>
      </div>
      <p>{c.saisonNote}</p>

      <!-- Visa -->
      <h2 id="visa">Formalités et visa</h2>
      <p>{c.visa.resume}</p>
      <div class="not-prose my-8 overflow-hidden rounded-brand border border-line">
        <dl class="divide-y divide-line">
          {[
            ['Durée autorisée', c.visa.duree],
            ['Coût', c.visa.cout],
            ['Procédure', c.visa.procedure],
          ].map(([k, v]) => (
            <div class="grid gap-1 bg-white px-5 py-4 sm:grid-cols-[10rem_1fr] sm:gap-6">
              <dt class="font-display text-[0.8rem] font-semibold uppercase tracking-wider text-warm-light">{k}</dt>
              <dd class="text-[0.95rem] leading-relaxed text-ink-soft">{v}</dd>
            </div>
          ))}
        </dl>
      </div>
      <RegleParPasseport country={c} />

      <VerifiedBadge date={c.verifieLe} sources={c.sourcesVisa} page={`/${c.slug}`} class="!my-8" />
      <p>
        Le détail des procédures, les délais réels et les pièges des sites intermédiaires sont
        traités dans le <a href="/visas-asie">guide des visas pour l'Asie</a>. Si votre itinéraire
        traverse une frontière, le <a href="/comparer-visas">comparateur de formalités</a> met
        deux ou trois pays côte à côte — c'est là que se voient les différences de durée, qui
        sont l'erreur la plus fréquente d'un voyage multi-pays.
      </p>

      <!-- Incontournables -->
      <h2 id="incontournables">Ce qui vaut vraiment le détour</h2>
      <ul>{c.incontournables.map((i) => <li>{i}</li>)}</ul>

      <h3>Et si vous voulez sortir du circuit</h3>
      <ul>{c.horsSentiers.map((i) => <li>{i}</li>)}</ul>

      <AdSlot placement="in-article" />

      <!-- Erreurs -->
      <h2 id="erreurs">Ce qu'il ne faut pas faire</h2>
      <p>
        Chacune de ces erreurs coûte de l'argent, du temps, ou les deux. Elles reviennent
        systématiquement dans les messages qu'on reçoit.
      </p>
      <ol>{c.erreurs.map((e) => <li>{e}</li>)}</ol>

      <Callout type="attention" title="Un réflexe qui vaut pour toute l'Asie">
        <p>
          Ne laissez jamais votre passeport en caution — ni pour un scooter, ni pour un hôtel,
          ni pour une excursion. Une photocopie ou une photo suffit, et c'est légalement ce
          qui est exigé. Le récupérer après un litige peut prendre des jours.
        </p>
      </Callout>

      <Visuel page={`/${c.slug}`} position="bande" seed={`${c.slug}-reserver`} accent={c.accent === 'ink' ? 'teal' : 'ink'} class="!my-10" />

      <!-- Réserver -->
      <h2 id="reserver">Réserver son voyage</h2>
      <p>
        Les liens ci-dessous sont des liens partenaires : ils ne changent rien à votre prix et
        financent l'écriture de ces guides. On n'y met que ce qu'on utilise réellement.
      </p>

      <div class="not-prose my-8 grid gap-5 sm:grid-cols-2">
        {[
          { p: 'booking' as const, titre: 'Hébergement', texte: "La meilleure couverture sur les petits hôtels familiaux, et l'annulation gratuite quasi partout.", cta: 'Chercher un hôtel' },
          { p: 'twelvego' as const, titre: 'Trains, bus et ferries', texte: "Le seul agrégateur fiable pour les transports terrestres en Asie du Sud-Est, avec les horaires réels.", cta: 'Voir les trajets' },
          { p: 'getyourguide' as const, titre: 'Activités et guides', texte: 'Annulation jusqu\'à 24 h avant, avis vérifiés, et des guides francophones sur les grandes villes.', cta: 'Voir les activités' },
          { p: 'chapka' as const, titre: 'Assurance voyage', texte: "Rapatriement et frais médicaux sans franchise sur la plupart des formules. Indispensable si vous roulez.", cta: "Comparer les formules" },
        ].map((b) => (
          <div class="flex flex-col rounded-brand border border-line bg-white p-6">
            <p class="font-display text-[1.05rem] font-bold text-ink">{b.titre}</p>
            <p class="mt-2 flex-1 text-[0.9rem] leading-relaxed text-warm">{b.texte}</p>
            <AffiliateLink
              partner={b.p}
              params={b.p === 'booking' ? { ss: c.nom } : b.p === 'getyourguide' ? { q: c.nom } : {}}
              path={b.p === 'getyourguide' ? '/s/' : undefined}
              class="mt-5 !w-full !py-3 !text-[0.88rem]"
            >
              {b.cta}
            </AffiliateLink>
          </div>
        ))}
      </div>

      {(lies.articles.length > 0 || lies.guides.length > 0) && (
        <section data-pagefind-ignore class="not-prose mt-16" id="tout-savoir">
          <h2 class="text-title">Tout ce qu'on a écrit sur {c.article === 'aux' ? 'les' : 'le'} {c.nom}</h2>
          <div class="mt-4 h-[3px] w-12 bg-amber"></div>

          {lies.articles.length > 0 && (
            <>
              <p class="eyebrow mt-8">Articles et guides pratiques</p>
              <div class="mt-4 grid gap-5 sm:grid-cols-2">
                {lies.articles.map((a) => (
                  <ArticleCard
                    href={`/blog/${a.id}`}
                    title={a.data.heading ?? a.data.title}
                    accroche={a.data.accroche}
                    meta={fmtCourt(a.data.pubDate)}
                  />
                ))}
              </div>
            </>
          )}

          {lies.guides.length > 0 && (
            <>
              <p class="eyebrow mt-10">Guides transversaux qui couvrent ce pays</p>
              <ul class="mt-4 flex flex-wrap gap-2.5">
                {lies.guides.map((g) => (
                  <li>
                    <a href={`/${g.id}`} class="chip !px-4 !py-2 !text-[0.85rem] transition-colors hover:border-teal hover:text-teal">
                      {g.data.heading ?? g.data.title}
                    </a>
                  </li>
                ))}
              </ul>
            </>
          )}
        </section>
      )}

      <VeillePays pays={c.slug} nom={c.nom} verifieLe={c.verifieLe} />

      <FAQ items={faq} title={`${c.nom} : les questions qu'on nous pose`} />

      {/*
        Sur une fiche pays, la lettre générique laisse la place à la veille
        personnelle : le lecteur est déjà là pour ce pays, la question de sa
        date de départ ne lui coûte rien, et la promesse devient vérifiable.
      */}
      <VeillePersonnelle country={c} class="mt-12" />
    </div>

    <!-- Colonne latérale -->
    <aside data-pagefind-ignore class="lg:sticky lg:top-24 lg:h-fit">
      <div class="mb-5 rounded-brand border border-line bg-cream-warm p-5">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">À emporter</p>
        <p class="mt-2 text-[0.9rem] leading-relaxed text-warm">
          Une page à imprimer : numéros de secours, ambassade de France, règle de visa.
          Utile le jour où le téléphone n'a plus de batterie.
        </p>
        <a href={`/fiche/${c.slug}`} class="btn-primary mt-4 !w-full !py-2.5 !text-[0.85rem]">
          Fiche {c.nom}
        </a>
      </div>

      <nav aria-label="Sommaire" class="rounded-brand border border-line bg-white p-5">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Sur cette page</p>
        <ul class="mt-4 space-y-2.5 text-[0.88rem]">
          {[
            ['#budget', 'Quel budget prévoir'],
            ['#saison', 'Quand partir'],
            ['#visa', 'Formalités et visa'],
            ['#incontournables', 'Ce qui vaut le détour'],
            ['#erreurs', "Ce qu'il ne faut pas faire"],
            ['#reserver', 'Réserver son voyage'],
            ['#tout-savoir', 'Tout ce qu\'on a écrit'],
          ].map(([href, label]) => (
            <li><a href={href} class="text-warm transition-colors hover:text-teal">{label}</a></li>
          ))}
        </ul>
      </nav>

      {related.length > 0 && (
        <nav aria-label="Guides liés" class="mt-6 rounded-brand border border-line bg-white p-5">
          <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">À lire ensuite</p>
          <ul class="mt-4 space-y-3.5">
            {related.map((r) => (
              <li>
                <a href={r.href} class="group block">
                  <span class="block font-display text-[0.9rem] font-semibold text-ink transition-colors group-hover:text-teal">{r.label}</span>
                  <span class="block text-[0.8rem] leading-snug text-warm">{r.hint}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <AdSlot placement="sidebar" class="!mt-6" />
    </aside>
  </div>
</article>
