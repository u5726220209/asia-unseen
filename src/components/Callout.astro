---
interface Props {
  type?: 'astuce' | 'attention' | 'verifie' | 'economie';
  title?: string;
  class?: string;
}
const { type = 'astuce', title, class: klass = '' } = Astro.props;

const styles = {
  astuce:    { border: 'border-teal',   bg: 'bg-teal-50',   label: 'text-teal-700',   defaultTitle: 'Astuce' },
  attention: { border: 'border-amber-700', bg: 'bg-amber-50', label: 'text-amber-700', defaultTitle: 'Attention' },
  // Cet encart s'appelait « Vu sur le terrain ». Il n'a jamais servi, mais il
  // restait disponible : le premier article qui l'aurait employé aurait affirmé
  // une présence sur place que ce site n'a pas. On ne laisse pas traîner un
  // outil dont le seul usage possible est de mentir.
  verifie:   { border: 'border-ink',    bg: 'bg-cream-warm', label: 'text-ink',       defaultTitle: 'Vérifié à la source' },
  // La palette de marque tient en deux couleurs : l'amber est réservé à ce qui
  // alerte ou appelle à l'action. Les encarts positifs partagent donc le
  // traitement teal — c'est le libellé qui les distingue, pas la couleur.
  economie:  { border: 'border-teal-400', bg: 'bg-teal-50', label: 'text-teal-700', defaultTitle: 'Ce que ça vous économise' },
}[type];
---

<div class:list={['my-8 rounded-brand border-l-[3px] px-6 py-5', styles.border, styles.bg, klass]}>
  <p class:list={['font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em]', styles.label]}>
    {title ?? styles.defaultTitle}
  </p>
  <div class="mt-2 text-[0.97rem] leading-relaxed text-ink-soft [&>*+*]:mt-3"><slot /></div>
</div>
