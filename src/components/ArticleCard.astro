---
interface Props {
  href: string;
  title: string;
  accroche: string;
  date?: Date;
  meta?: string;
  featured?: boolean;
}
const { href, title, accroche, date, meta, featured = false } = Astro.props;
const dateStr = date
  ? new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
  : null;
---

<article class:list={['group card p-6', featured && 'sm:p-9']}>
  {meta && <p class="eyebrow">{meta}</p>}
  <h3 class:list={['mt-2 font-display font-bold tracking-tight text-ink transition-colors group-hover:text-teal', featured ? 'text-title' : 'text-[1.15rem] leading-snug']}>
    <a href={href} class="after:absolute after:inset-0">{title}</a>
  </h3>
  <p class:list={['mt-3 leading-relaxed text-warm', featured ? 'text-[1.02rem]' : 'text-[0.92rem] line-clamp-3']}>{accroche}</p>
  {dateStr && <p class="mt-5 text-[0.78rem] text-warm-light">{dateStr}</p>}
</article>
