---
interface Props {
  href: string;
  title: string;
  accroche: string;
  date?: Date;
  meta?: string;
  featured?: boolean;
  /**
   * La langue de la date affichée.
   *
   * La carte formatait en `fr-FR` en dur, ce qui était juste tant qu'elle ne
   * servait qu'au site français. Réutilisée telle quelle sur la liste
   * anglaise, elle y aurait écrit « 12 octobre 2026 » sous un titre anglais —
   * le genre de détail qui ne casse rien et qui fait douter du reste.
   */
  langue?: 'fr' | 'en';
  /**
   * Le niveau du titre de la carte.
   *
   * `h3` par défaut, parce qu'une carte vit presque toujours sous une section
   * qui a son `h2` — « Tout ce qu'on a écrit sur le Vietnam », « Les derniers
   * articles ». Sur une page de liste, il n'y a pas de section au-dessus : les
   * cartes sont le contenu, et un `h3` y saute un niveau depuis le `h1`.
   *
   * On ne devine pas le contexte, on le demande : une carte ne peut pas savoir
   * ce qu'il y a au-dessus d'elle, et deviner mal produirait un plan de page
   * faux sans que rien ne le signale.
   */
  niveau?: 2 | 3;
}
const { href, title, accroche, date, meta, featured = false, langue = 'fr', niveau = 3 } = Astro.props;
const Titre = `h${niveau}` as 'h2' | 'h3';
const dateStr = date
  ? new Intl.DateTimeFormat(langue === 'en' ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(date)
  : null;
---

<article class:list={['group card p-6', featured && 'sm:p-9']}>
  {meta && <p class="eyebrow">{meta}</p>}
  <Titre class:list={['mt-2 font-display font-bold tracking-tight text-ink transition-colors group-hover:text-teal', featured ? 'text-title' : 'text-[1.15rem] leading-snug']}>
    <a href={href} class="after:absolute after:inset-0">{title}</a>
  </Titre>
  <p class:list={['mt-3 leading-relaxed text-warm', featured ? 'text-[1.02rem]' : 'text-[0.92rem] line-clamp-3']}>{accroche}</p>
  {dateStr && <p class="mt-5 text-[0.78rem] text-warm-light">{dateStr}</p>}
</article>
