---
import { testimonials } from '@/data/testimonials';
/** Ne rend rien tant qu'aucun témoignage réel n'a été collecté. Voir src/data/testimonials.ts. */
---
{testimonials.length > 0 && (
  <section class="wrap py-20">
    <p class="eyebrow">Retours de lecteurs</p>
    <h2 class="mt-3 max-w-2xl text-display">Ils ont préparé leur voyage avec ces guides</h2>
    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {testimonials.map((t) => (
        <figure class="rounded-brand border border-line bg-white p-7">
          <blockquote class="font-accent text-[1.4rem] leading-snug text-ink">« {t.quote} »</blockquote>
          <figcaption class="mt-5 border-t border-line pt-4">
            <span class="block font-display text-[0.9rem] font-semibold text-ink">{t.auteur}</span>
            <span class="block text-[0.82rem] text-warm">{t.contexte}</span>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>
)}
