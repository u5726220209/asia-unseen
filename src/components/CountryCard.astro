---
import type { Country } from '@/data/countries';
import { MOIS } from '@/data/countries';
import Photo from '@/components/Photo.astro';
import { photoPour } from '@/data/photos';
interface Props { country: Country; }
const { country: c } = Astro.props;

/**
 * La photographie de la fiche pays coiffe aussi sa vignette.
 *
 * Elle existait déjà et ne servait qu'une fois. La grille d'accueil d'un site
 * de voyage n'affichait, elle, aucune image — neuf cartes de texte pour
 * annoncer neuf pays. Rien à sourcer, rien à vérifier de plus : ce sont les
 * mêmes fichiers, les mêmes licences, le même contrôle visuel déjà fait.
 *
 * La carte reste entière si la photo manque : c'est la règle du registre, et
 * un pays ajouté demain s'affichera sans image plutôt que de casser la grille.
 */
const photo = photoPour(`/${c.slug}`, 'hero');
/**
 * La carte affichait la première clause du coût, et neuf cartes disaient neuf
 * choses de longueurs différentes : « Gratuit sous exemption », « ≈ 30 à 50 USD
 * selon la nationalité et le point d'entrée », et pour la Corée une phrase
 * entière sur un K-ETA facultatif. Impossible de comparer neuf pays d'un coup
 * d'œil — ce qui est pourtant la seule raison de mettre neuf cartes côte à côte.
 *
 * Surtout, aucune ne répondait à la question que la personne se pose vraiment :
 * combien de jours puis-je rester. Ce nombre existe désormais en clair dans les
 * données, il est vérifié à chaque mise en ligne, et il bascule tout seul le
 * jour où une règle datée entre en vigueur.
 */
const visaCourt =
  c.visa.sansVisaJours > 0
    ? `${c.visa.sansVisaJours} jours sans visa`
    : 'Visa obligatoire';

/** Une règle déjà publiée dont la date d'effet approche : la carte le dit. */
const bascule = c.visa.sansVisaJoursApres;
const basculeAVenir =
  bascule && bascule.date > new Date().toISOString().slice(0, 10) ? bascule : null;

const best = c.saisons
  .map((s, i) => ({ s, m: MOIS[i] }))
  .filter((x) => x.s === 3)
  .map((x) => x.m);
---

<a href={`/${c.slug}`} class="group card overflow-hidden !p-0">
  {photo && (
    <div class="overflow-hidden">
      <Photo
        photo={photo}
        variant="carte"
        class="[&_img]:transition-transform [&_img]:duration-500 group-hover:[&_img]:scale-[1.04]"
      />
    </div>
  )}

  <div class="p-6">
  <div class="flex items-start justify-between gap-4">
    <h3 class="font-display text-[1.35rem] font-bold tracking-tight text-ink transition-colors group-hover:text-teal">
      {c.nom}
    </h3>
    <span class="mt-1 shrink-0 font-display text-[0.72rem] font-semibold uppercase tracking-[0.14em] text-amber-700">
      dès {c.budget.routard} €/j
    </span>
  </div>

  <p class="mt-3 line-clamp-3 text-[0.92rem] leading-relaxed text-warm">{c.resume}</p>

  <dl class="mt-5 space-y-1.5 border-t border-line pt-4 text-[0.82rem]">
    <div class="flex gap-2">
      <dt class="w-20 shrink-0 text-warm-light">Visa</dt>
      <dd class="text-ink-soft">
        {visaCourt}
        {basculeAVenir && (
          <span class="ml-1.5 whitespace-nowrap rounded-full bg-amber-100 px-2 py-0.5 font-display text-[0.7rem] font-semibold text-amber-700">
            {basculeAVenir.jours} j dès le {new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short' }).format(new Date(`${basculeAVenir.date}T00:00:00`))}
          </span>
        )}
      </dd>
    </div>
    <div class="flex gap-2">
      <dt class="w-20 shrink-0 text-warm-light">Saison</dt>
      <dd class="text-ink-soft">{best.length ? best.join(' · ') : 'Variable selon les régions'}</dd>
    </div>
  </dl>

  <span class="mt-5 inline-flex items-center gap-1.5 font-display text-[0.85rem] font-semibold text-teal">
    Le guide complet
    <svg viewBox="0 0 16 16" class="h-3.5 w-3.5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M2.5 8h11M9 3.5 13.5 8 9 12.5" />
    </svg>
  </span>
  </div>
</a>
