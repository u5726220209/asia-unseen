---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Photo } from '@/data/photos';

/**
 * Rendu d'une photographie déclarée dans le registre.
 *
 * Astro se charge du redimensionnement, des formats et du srcset : le
 * navigateur télécharge la variante adaptée à son écran, jamais l'originale.
 * Les dimensions sont connues à la compilation, il n'y a donc aucun décalage
 * de mise en page au chargement.
 *
 * AVIF d'abord, WebP en repli. Sur ces photographies, l'AVIF pèse 20 à 40 % de
 * moins à qualité égale — mesuré, pas supposé. Les navigateurs qui ne le lisent
 * pas reçoivent le WebP sans que la page change.
 */
interface Props {
  photo: Photo;
  variant?: 'hero' | 'bande' | 'carte';
  /** Chargement immédiat pour la première image visible d'une page. */
  prioritaire?: boolean;
  class?: string;
}
const { photo, variant = 'hero', prioritaire = false, class: klass = '' } = Astro.props;

// import.meta.glob permet un registre piloté par la donnée tout en gardant
// l'optimisation d'Astro, qui exige normalement des imports statiques.
const fichiers = import.meta.glob<{ default: ImageMetadata }>(
  '/src/photos/**/*.{jpeg,jpg,png,webp,avif}',
);

const chemin = `/src/photos/${photo.fichier}`;
const mod = fichiers[chemin];

if (!mod) {
  throw new Error(
    `Photo déclarée mais introuvable : src/photos/${photo.fichier}\n` +
      `Vérifiez le nom du fichier dans src/data/photos.ts, ou lancez « npm run photos ».`,
  );
}

const source = (await mod()).default;

/**
 * La variante « carte » coiffe une vignette dans une grille.
 *
 * Elle ne demande que 400 px de large environ : lui servir le même srcset
 * qu'un bandeau pleine largeur ferait télécharger neuf images de 1280 px pour
 * les afficher en 400. D'où des largeurs et un `sizes` qui lui sont propres.
 */
const hauteurs =
  variant === 'hero' ? 'h-56 sm:h-72 lg:h-[26rem]'
  : variant === 'carte' ? 'h-40'
  : 'h-40 sm:h-52';

const carte = variant === 'carte';
const largeurs = carte ? [400, 600, 800] : [640, 960, 1280, 1920];
const tailles = carte ? '(min-width: 1024px) 400px, (min-width: 640px) 50vw, 100vw' : '100vw';
---

<figure class:list={['not-prose m-0', carte && 'relative', klass]}>
  <div class:list={['w-full overflow-hidden bg-cream-warm', hauteurs]}>
    <Picture
      src={source}
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      alt={photo.alt}
      width={Math.min(source.width, carte ? 800 : 1920)}
      widths={largeurs}
      sizes={tailles}
      {/*
        Astro applique le même nombre aux deux formats. 65 donne un AVIF net —
        le format que reçoit la quasi-totalité des navigateurs — et un WebP de
        repli légèrement plus doux, ce qui est le bon arbitrage : optimiser
        pour la minorité coûterait à tout le monde.
      */}
      quality={65}
      loading={prioritaire ? 'eager' : 'lazy'}
      fetchpriority={prioritaire ? 'high' : 'auto'}
      decoding="async"
      class="h-full w-full object-cover"
    />
  </div>

  {/*
    La licence CC BY exige le crédit là où l'image est montrée, pas seulement
    sur la page où elle est grande. Une légende sous une vignette ajouterait
    neuf lignes de texte à la grille d'accueil ; l'usage de presse — un filet
    en surimpression dans un coin — dit la même chose sans rien coûter à la
    lecture. Le nom reste sélectionnable et lu par les lecteurs d'écran.
  */}
  {carte && photo.credit && (
    <figcaption class="pointer-events-none absolute bottom-0 right-0 bg-ink/55 px-2 py-1 text-[0.62rem] leading-none tracking-wide text-cream/90">
      {photo.credit.auteur}{photo.licence ? ` · ${photo.licence.nom}` : ''}
    </figcaption>
  )}

  {!carte && (photo.legende || photo.credit) && (
    <figcaption class="wrap flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 py-3 text-[0.78rem] text-warm">
      {photo.legende && <span class="max-w-2xl leading-relaxed">{photo.legende}</span>}
      {photo.credit && (
        <span class="ml-auto text-warm-light">
          {photo.credit.url ? (
            <a href={photo.credit.url} target="_blank" rel="noopener nofollow" class="underline decoration-warm-light/40 underline-offset-2 hover:text-warm">
              {photo.credit.auteur}
            </a>
          ) : photo.credit.auteur}
          {' · '}{photo.credit.source}
        </span>
      )}
    </figcaption>
  )}
</figure>
