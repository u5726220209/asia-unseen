---
import { newsletter } from '@/data/site';
import { countries } from '@/data/countries';
import ChampsBrevo from '@/components/ChampsBrevo.astro';

interface Props {
  variant?: 'block' | 'inline' | 'compact';
  title?: string;
  /**
   * Ce qu'on promet, quand la promesse générale ne convient pas.
   *
   * « Une fiche de départ par pays » parle à quelqu'un qui prépare un voyage.
   * Elle ne dit rien à quelqu'un qui compare des assurances : on lui répond à
   * côté de sa question, au seul endroit du site où on lui demande son
   * adresse. Les pages qui savent mieux le disent.
   */
  promesse?: string;
  class?: string;
}
/**
 * Le titre par défaut valait `Recevez nos ${newsletter.leadMagnet}`, et
 * `leadMagnet` commence par « Les ». Cinquante-neuf pages affichaient donc
 * « Recevez nos Les fiches de départ — une par pays d'Asie », en titre du
 * seul élément de conversion du site. Une phrase composée par concaténation
 * n'est pas une phrase : il faut la lire une fois assemblée.
 *
 * Le nombre vient du contenu plutôt que d'un mot écrit à la main — le jour où
 * un dixième pays s'ajoute, « neuf » deviendrait faux partout à la fois.
 */
const enLettres = ['zéro', 'une', 'deux', 'trois', 'quatre', 'cinq', 'six', 'sept', 'huit', 'neuf', 'dix'];
const nb = countries.length;
const combien = enLettres[nb] ?? String(nb);

/**
 * La version courte, pour l'encart intercalé dans un article.
 *
 * Elle n'est pas une troncature de la longue : un encart au milieu d'un texte
 * dispose de deux lignes, pas de cinq. Quand une page fournit sa promesse, on
 * la reprend telle quelle — c'est elle qui sait ce qu'elle a à dire.
 */
const PROMESSE_COURTE_PAR_DEFAUT =
  'Une fiche par pays : urgences, visa, budget. Rééditée quand une règle officielle change.';

const PROMESSE_PAR_DEFAUT =
  "Une fiche de départ par pays : règle de visa, numéros d'urgence, budget réel, " +
  'et les dépenses qui coûtent cher. Vérifiée aux sources officielles — et ' +
  "rééditée dès qu'une règle change.";

const {
  variant = 'block',
  title = `Recevez les ${combien} fiches de départ`,
  promesse,
  class: klass = '',
} = Astro.props;

const texteLong = promesse ?? PROMESSE_PAR_DEFAUT;
const promesseCourte = promesse ?? PROMESSE_COURTE_PAR_DEFAUT;

// Sans endpoint configuré, le formulaire reste inerte plutôt que d'échouer
// silencieusement : on affiche l'adresse de contact directe.
const action = newsletter.endpoint;
const id = 'nl-' + Math.random().toString(36).slice(2, 8);
---

{variant === 'block' && (
  <section data-pagefind-ignore class:list={['relative overflow-hidden rounded-brand bg-ink px-6 py-12 sm:px-12 sm:py-16', klass]}>
    <svg viewBox="0 0 64 64" aria-hidden="true" class="pointer-events-none absolute -right-8 -top-8 h-56 w-56 opacity-[0.07]">
      <g fill="none" stroke="#F9FAFB" stroke-linecap="round" stroke-width="7">
        <path d="M9 55 28.5 18" /><path d="M35.5 18 55 55" /><path d="M17 41H47" />
      </g>
    </svg>
    <div class="relative max-w-2xl">
      <p class="eyebrow !text-amber">Gratuit · sans spam</p>
      <h2 class="mt-3 text-display text-cream">{title}</h2>
      <p class="mt-4 text-[1.05rem] leading-relaxed text-warm-light">{texteLong}</p>
      <form
        class="au-nl mt-8 flex flex-col gap-3 sm:flex-row"
        action={action || undefined}
        method="post"
        data-configured={action ? 'true' : 'false'}
      >
        <label for={id} class="sr-only">Votre adresse email</label>
        <input
          id={id} type="email" name={newsletter.champEmail} required autocomplete="email"
          placeholder="vous@exemple.com"
          class="min-w-0 flex-1 rounded-brand border border-white/15 bg-white/[0.06] px-5 py-3.5 text-cream placeholder:text-warm focus:border-amber focus:outline-none"
        />
        <ChampsBrevo />
        <button type="submit" class="btn-primary shrink-0">Envoyez-les moi</button>
      </form>
      <p class="au-nl-msg mt-4 hidden text-sm text-amber-300" role="status"></p>
      <p class="mt-4 text-[0.8rem] leading-relaxed text-warm">
        {newsletter.rgpd.texte}{' '}
        <a href={newsletter.rgpd.lienUrl} class="underline decoration-warm/50 underline-offset-2 hover:text-warm-light">
          {newsletter.rgpd.lienTexte}
        </a>.
      </p>
    </div>
  </section>
)}

{variant === 'inline' && (
  <aside data-pagefind-ignore class:list={['my-12 rounded-brand border-l-[3px] border-amber bg-amber-50 px-6 py-7', klass]}>
    <p class="eyebrow !text-amber-700">Avant d'aller plus loin</p>
    <h3 class="mt-2 font-display text-xl font-bold text-ink">{title}</h3>
    <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">{promesseCourte}</p>
    <form class="au-nl mt-5 flex flex-col gap-2.5 sm:flex-row" action={action || undefined} method="post" data-configured={action ? 'true' : 'false'}>
      <label for={id} class="sr-only">Votre adresse email</label>
      <input
        id={id} type="email" name={newsletter.champEmail} required autocomplete="email" placeholder="vous@exemple.com"
        class="min-w-0 flex-1 rounded-brand border border-ink/15 bg-white px-4 py-3 text-ink placeholder:text-warm-light focus:border-teal focus:outline-none"
      />
      <ChampsBrevo />
      <button type="submit" class="btn-dark shrink-0 !py-3">Je m'inscris</button>
    </form>
    <p class="au-nl-msg mt-3 hidden text-sm text-teal-700" role="status"></p>
    <p class="mt-3 text-[0.78rem] leading-relaxed text-warm">
      {newsletter.rgpd.texte}{' '}
      <a href={newsletter.rgpd.lienUrl} class="underline decoration-warm-light/60 underline-offset-2 hover:text-ink">
        {newsletter.rgpd.lienTexte}
      </a>.
    </p>
  </aside>
)}

{variant === 'compact' && (
  <div data-pagefind-ignore class:list={[klass]}>
    <form class="au-nl flex flex-col gap-2.5 sm:flex-row" action={action || undefined} method="post" data-configured={action ? 'true' : 'false'}>
      <label for={id} class="sr-only">Votre adresse email</label>
      <input
        id={id} type="email" name={newsletter.champEmail} required autocomplete="email" placeholder="vous@exemple.com"
        class="min-w-0 flex-1 rounded-brand border border-white/15 bg-white/[0.06] px-4 py-3 text-cream placeholder:text-warm focus:border-amber focus:outline-none"
      />
      <ChampsBrevo />
      <button type="submit" class="btn-primary shrink-0 !py-3 !text-[0.85rem]">S'inscrire</button>
    </form>
    {/*
      Cette variante s'affiche sur deux fonds opposés : l'encre du pied de page
      et le blanc de la fenêtre de sortie. Une couleur de texte seule serait
      illisible sur l'un des deux, alors le message peint son propre fond.
    */}
    <p class="au-nl-msg mt-3 hidden rounded-brand bg-cream-warm px-4 py-3 text-sm leading-relaxed text-ink-soft" role="status"></p>
  </div>
)}

<script>
  // Tant qu'aucun endpoint n'est configuré (PUBLIC_NEWSLETTER_ENDPOINT), une
  // soumission partirait dans le vide. On l'intercepte et on l'explique.
  //
  // Le message a déjà manqué une fois : la variante compacte, celle du pied de
  // page et de la fenêtre de sortie, n'avait pas de <p class="au-nl-msg">. Le
  // clic était donc annulé sans rien afficher — un formulaire qui ne réagit pas
  // du tout est pire qu'un formulaire qui échoue, parce que le visiteur croit
  // que c'est lui qui s'y prend mal. D'où le repli : si l'élément manque, on le
  // fabrique. Aucune variante future ne pourra plus avaler le clic en silence.
  // Ce que promettent ces formulaires — les neuf fiches de départ — existe déjà
  // et se télécharge en un clic. Tant que l'envoi d'emails n'est pas ouvert, le
  // repli livre donc le document au lieu de s'excuser : la promesse faite en
  // haut de page est tenue, et l'inscription ne sert plus qu'aux rééditions.
  const MESSAGE =
    "Les inscriptions ne sont pas encore ouvertes. Mais les fiches, elles, sont prêtes :";
  const LIEN = '/telechargements/fiches-depart-asie.pdf';
  const LIBELLE = 'télécharger les neuf fiches (PDF)';

  document.querySelectorAll<HTMLFormElement>('form.au-nl').forEach((form) => {
    form.addEventListener('submit', (e) => {
      if (form.dataset.configured === 'true') return;
      e.preventDefault();

      let msg = form.parentElement?.querySelector<HTMLElement>('.au-nl-msg') ?? null;
      if (!msg) {
        msg = document.createElement('p');
        msg.className = 'au-nl-msg mt-3 rounded-brand bg-cream-warm px-4 py-3 text-sm leading-relaxed text-ink-soft';
        msg.setAttribute('role', 'status');
        form.insertAdjacentElement('afterend', msg);
      }
      // Construit sans innerHTML : rien ici ne vient de l'utilisateur, mais un
      // composant réutilisé partout n'est pas l'endroit où prendre l'habitude.
      msg.textContent = MESSAGE + ' ';
      const a = document.createElement('a');
      a.href = LIEN;
      a.setAttribute('download', '');
      a.className = 'underline underline-offset-2 font-semibold';
      a.textContent = LIBELLE;
      msg.appendChild(a);
      msg.hidden = false;
      msg.classList.remove('hidden');
    });
  });
</script>
