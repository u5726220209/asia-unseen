---
import { newsletter } from '@/data/site';
import ChampsBrevo from '@/components/ChampsBrevo.astro';
import type { Country } from '@/data/countries';

/**
 * La veille personnelle.
 *
 * La promesse ordinaire d'une lettre de voyage — « recevez nos conseils » —
 * est servie à l'identique par des milliers de sites. Celle-ci ne peut être
 * tenue que par un site qui relit chaque nuit les portails officiels :
 * « si une règle change au Vietnam avant votre départ, vous le saurez ».
 *
 * D'où les deux champs supplémentaires. Ils ne sont pas là pour enrichir un
 * fichier client : sans le pays, on ne sait pas qui prévenir ; sans la date,
 * on ne sait pas quand cesser de le faire. Les demander sur la page d'un pays
 * est le seul endroit où la question ne coûte rien — le lecteur y est déjà
 * pour ce pays-là.
 *
 * Le formulaire du pied de page reste à un seul champ. Les deux attributs sont
 * facultatifs côté Brevo, précisément pour que ces inscriptions-là continuent
 * de passer sans rien demander de plus.
 *
 * LE PIÈGE DE LA DATE
 * Brevo attend `dd-mm-yyyy`, et un `<input type="date">` produit `yyyy-mm-jj`.
 * Poster la valeur brute ferait rejeter l'attribut en silence : l'inscription
 * réussirait, la date serait perdue, et personne ne le verrait. La conversion
 * se fait donc à l'envoi, dans un champ caché — le visiteur garde le sélecteur
 * de date de son navigateur, Brevo reçoit le format qu'il exige.
 */
interface Props {
  country: Country;
  class?: string;
}
const { country: c, class: klass = '' } = Astro.props;

const action = newsletter.endpoint;
const id = 'vp-' + c.slug;
---

<section
  data-pagefind-ignore
  class:list={['not-prose relative overflow-hidden rounded-brand bg-ink px-6 py-9 sm:px-9', klass]}
>
  <svg viewBox="0 0 64 64" aria-hidden="true" class="pointer-events-none absolute -right-6 -top-6 h-44 w-44 opacity-[0.06]">
    <g fill="none" stroke="#F9FAFB" stroke-linecap="round" stroke-width="7">
      <path d="M9 55 28.5 18" /><path d="M35.5 18 55 55" /><path d="M17 41H47" />
    </g>
  </svg>

  <div class="relative max-w-2xl">
    <p class="eyebrow !text-amber">Veille personnelle · gratuit</p>
    <h2 class="mt-3 font-display text-[1.6rem] font-bold leading-tight text-cream sm:text-[1.9rem]">
      Une règle change {c.article} {c.nom} avant votre départ&nbsp;?
      <span class="text-amber">Vous le saurez.</span>
    </h2>
    <p class="mt-4 text-[1.02rem] leading-relaxed text-warm-light">
      Ce site relit chaque nuit les portails officiels. Dites-nous quand vous partez :
      si une formalité bouge d'ici là, la fiche corrigée vous parvient — avec l'avant,
      l'après et la source. Et plus rien après votre retour.
    </p>

    <form
      class="au-vp mt-8 grid gap-4 sm:grid-cols-[1fr_auto] sm:items-end"
      action={action || undefined}
      method="post"
      data-configured={action ? 'true' : 'false'}
    >
      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label for={`${id}-mail`} class="mb-1.5 block font-display text-[0.7rem] font-semibold uppercase tracking-wider text-warm">
            Votre adresse email
          </label>
          <input
            id={`${id}-mail`} type="email" name={newsletter.champEmail} required autocomplete="email"
            placeholder="vous@exemple.com"
            class="w-full rounded-brand border border-white/15 bg-white/[0.06] px-4 py-3 text-cream placeholder:text-warm focus:border-amber focus:outline-none"
          />
        </div>
        <div>
          <label for={`${id}-date`} class="mb-1.5 block font-display text-[0.7rem] font-semibold uppercase tracking-wider text-warm">
            Date de départ <span class="font-normal normal-case tracking-normal opacity-70">— si vous la connaissez</span>
          </label>
          <input
            id={`${id}-date`} type="date"
            class="au-vp-date w-full rounded-brand border border-white/15 bg-white/[0.06] px-4 py-3 text-cream focus:border-amber focus:outline-none [color-scheme:dark]"
          />
        </div>
      </div>

      {/*
        Le pays n'est pas demandé : la page le dit déjà. Le poser en question
        serait faire remplir au lecteur ce que le site sait pertinemment.
      */}
      <input type="hidden" name="PAYS_SURVEILLE" value={c.nom} />
      <input type="hidden" name="DATE_DEPART" value="" class="au-vp-date-brevo" />
      <ChampsBrevo />

      <button type="submit" class="btn-primary h-fit">Me prévenir</button>
    </form>

    <p class="au-vp-msg mt-4 hidden rounded-brand bg-cream-warm px-4 py-3 text-sm leading-relaxed text-ink-soft" role="status"></p>

    <p class="mt-4 text-[0.8rem] leading-relaxed text-warm">
      {newsletter.rgpd.texte}{' '}
      <a href={newsletter.rgpd.lienUrl} class="underline decoration-warm/50 underline-offset-2 hover:text-warm-light">
        {newsletter.rgpd.lienTexte}
      </a>.
    </p>
  </div>
</section>

<script>
  /**
   * Deux choses, et une seule compte vraiment.
   *
   * La conversion de date : `<input type="date">` rend « 2027-02-14 », Brevo
   * exige « 14-02-2027 ». Un attribut mal formé est rejeté sans bruit — la
   * personne serait inscrite, la date perdue, et rien ne le signalerait. On
   * remplit donc un champ caché au bon format juste avant l'envoi.
   *
   * Et le repli, identique à celui de la lettre : tant qu'aucune adresse de
   * service n'est configurée, la soumission est interceptée et expliquée
   * plutôt que perdue.
   */
  document.querySelectorAll<HTMLFormElement>('form.au-vp').forEach((form) => {
    const visible = form.querySelector<HTMLInputElement>('.au-vp-date');
    const cache = form.querySelector<HTMLInputElement>('.au-vp-date-brevo');

    const convertir = () => {
      if (!visible || !cache) return;
      const v = visible.value;
      cache.value = /^\d{4}-\d{2}-\d{2}$/.test(v)
        ? `${v.slice(8, 10)}-${v.slice(5, 7)}-${v.slice(0, 4)}`
        : '';
    };

    visible?.addEventListener('change', convertir);

    form.addEventListener('submit', (e) => {
      convertir();
      if (form.dataset.configured === 'true') return;
      e.preventDefault();
      const msg = form.parentElement?.querySelector<HTMLElement>('.au-vp-msg');
      if (msg) {
        msg.textContent =
          "Les inscriptions ne sont pas encore ouvertes. Mais les fiches, elles, sont prêtes : ";
        const a = document.createElement('a');
        a.href = '/telechargements/fiches-depart-asie.pdf';
        a.setAttribute('download', '');
        a.className = 'underline underline-offset-2 font-semibold';
        a.textContent = 'télécharger les neuf fiches (PDF)';
        msg.appendChild(a);
        msg.hidden = false;
        msg.classList.remove('hidden');
      }
    });
  });
</script>
