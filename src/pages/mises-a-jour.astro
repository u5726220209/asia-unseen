---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Visuel from '@/components/Visuel.astro';
import Newsletter from '@/components/Newsletter.astro';
import { corrections, nbCorrections, ancre } from '@/data/corrections';
import { site } from '@/data/site';

/**
 * Journal public des corrections.
 *
 * La plupart des sites de voyage affichent une date de mise à jour sans jamais
 * dire ce qui a changé. Cette page fait l'inverse : elle rend la promesse
 * « daté, donc vérifiable » réellement vérifiable.
 */

/** Combien de corrections doivent leur existence à un lecteur. */
const nbSignalees = corrections.filter((c) => c.signalePar).length;

const parMois = corrections.reduce<Record<string, typeof corrections>>((acc, c) => {
  const mois = c.date.slice(0, 7);
  (acc[mois] ??= []).push(c);
  return acc;
}, {});

const ordre = { critique: 0, correction: 1, precision: 2 } as const;
const mois = Object.entries(parMois)
  .sort((a, b) => b[0].localeCompare(a[0]))
  .map(([m, list]) => [m, [...list].sort((a, b) => ordre[a.gravite] - ordre[b.gravite])] as const);

const STYLES = {
  critique: { label: 'Correction critique', chip: 'border-amber-700 bg-amber-50 text-amber-700', bar: 'bg-amber-700' },
  correction: { label: 'Correction', chip: 'border-teal bg-teal-50 text-teal-700', bar: 'bg-teal' },
  precision: { label: 'Précision', chip: 'border-line bg-cream-warm text-warm', bar: 'bg-line' },
} as const;

const fmtMois = (m: string) =>
  new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric' }).format(new Date(`${m}-01T00:00:00`));
const fmtJour = (d: string) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date(`${d}T00:00:00`));

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Journal des corrections',
    description: "Toutes les corrections apportées aux informations de formalités et de tarifs, avec leur source officielle.",
    inLanguage: 'fr-FR',
    isPartOf: { '@id': `${site.url}/#organization` },
  },
];
---

<BaseLayout
  title="Journal des corrections — ce qui a changé, et pourquoi"
  description="Toutes les corrections apportées au site : ce qu'il affirmait, ce que dit la source officielle, et la date. La preuve que « daté » veut dire vérifiable."
  schema={schema}
  jumelle="/en/updates"
>
  <header class="border-b border-line bg-cream-warm">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs items={[{ label: 'Journal des corrections' }]} />
      <h1 class="mt-6 max-w-3xl text-hero">Ce qui a changé, et pourquoi</h1>
      <p class="mt-6 max-w-2xl text-[1.15rem] leading-relaxed text-warm">
        Une information de voyage sans date est une information morte. Une date sans journal
        des changements n'est qu'une affirmation. Voici les deux.
      </p>
      <p class="mt-4 max-w-2xl text-[0.95rem] leading-relaxed text-warm-light">
        Les règles elles-mêmes sont publiées en accès libre, sources et dates comprises :
        <a href="/donnees" class="text-teal-700 underline decoration-teal/30 underline-offset-4 hover:decoration-amber">voir le jeu de données</a>.
      </p>

      <dl class="mt-10 flex flex-wrap gap-x-12 gap-y-5">
        <div>
          <dt class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Corrections publiées</dt>
          <dd class="mt-1 font-display text-[2.2rem] font-bold leading-none tracking-tight text-ink">{nbCorrections}</dd>
        </div>
        <div>
          <dt class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Dernier audit</dt>
          <dd class="mt-1 font-display text-[2.2rem] font-bold leading-none tracking-tight text-ink">{fmtJour(corrections[0].date)}</dd>
        </div>
        <div>
          <dt class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Signalées par un lecteur</dt>
          <dd class="mt-1 font-display text-[2.2rem] font-bold leading-none tracking-tight text-ink">{nbSignalees}</dd>
        </div>
        <div>
          <dt class="font-display text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Suivre les corrections</dt>
          <dd class="mt-2"><a href="/mises-a-jour/rss.xml" class="link">Flux RSS dédié</a></dd>
        </div>
      </dl>
    </div>
  </header>

  <Visuel page="/mises-a-jour" seed="mises-a-jour" prioritaire accent="ink" />

  <div class="wrap grid gap-14 py-14 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
    <div class="min-w-0">
      {/*
        L'invitation vient avant le mode d'emploi, et c'est délibéré : quelqu'un
        qui arrive ici a déjà compris que le site se corrige en public. Ce qu'il
        ignore, c'est qu'il peut en être la cause.
      */}
      <div class="rounded-brand bg-ink px-6 py-6 sm:px-8 sm:py-7">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-amber">Vous pouvez remplir cette page</p>
        <p class="mt-3 text-[1.02rem] leading-relaxed text-cream">
          Une veille automatique voit qu'une page officielle a changé. Elle ne voit pas
          qu'un guichet applique déjà une règle que le portail n'annonce pas encore.
          Quelqu'un qui rentre d'Asie, si.
        </p>
        <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
          <a href="/verifier" class="btn-primary inline-flex !py-2.5 !text-[0.88rem]">Comment signaler un changement</a>
          <a href="/veille" class="text-[0.88rem] text-warm-light underline decoration-warm/40 underline-offset-4 hover:text-cream">Voir ce que la machine a relu cette nuit</a>
        </div>
      </div>

      <div class="mt-5 rounded-brand border-l-[3px] border-teal bg-teal-50 px-6 py-5">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-teal-700">Comment lire cette page</p>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink-soft">
          Chaque entrée indique ce que le site affirmait, ce que dit la source officielle, et
          le lien pour vérifier vous-même. Les corrections <strong>critiques</strong> sont celles
          qui pouvaient mettre un lecteur en difficulté à une frontière.
        </p>
      </div>

      {mois.map(([m, list]) => (
        <section class="mt-14">
          <h2 class="text-title capitalize">{fmtMois(m)}</h2>
          <div class="mt-4 h-[3px] w-12 bg-amber"></div>

          <ol class="mt-8 space-y-5">
            {list.map((c) => (
              <li id={ancre(c)} class="scroll-mt-24 overflow-hidden rounded-brand border border-line bg-white target:ring-2 target:ring-amber">
                <div class={`h-[3px] w-full ${STYLES[c.gravite].bar}`}></div>
                <div class="p-6">
                  <div class="flex flex-wrap items-center gap-3">
                    <span class={`inline-flex rounded-full border px-3 py-1 font-display text-[0.68rem] font-semibold uppercase tracking-wider ${STYLES[c.gravite].chip}`}>
                      {STYLES[c.gravite].label}
                    </span>
                    <a href={c.page} class="font-display text-[0.82rem] font-semibold text-teal-700 underline decoration-teal/30 underline-offset-4 hover:decoration-amber">
                      {c.pageLabel}
                    </a>
                    <a href={`#${ancre(c)}`} class="ml-auto text-[0.78rem] text-warm-light underline decoration-transparent underline-offset-4 transition hover:decoration-warm-light" title="Lien permanent vers cette correction">
                      <time datetime={c.date}>{fmtJour(c.date)}</time>
                    </a>
                  </div>

                  <h3 class="mt-4 font-display text-[1.1rem] font-bold leading-snug text-ink">{c.titre}</h3>

                  <dl class="mt-5 grid gap-px overflow-hidden rounded-brand border border-line bg-line sm:grid-cols-2">
                    <div class="bg-cream-warm p-4">
                      <dt class="font-display text-[0.68rem] font-semibold uppercase tracking-wider text-warm-light">Ce que le site disait</dt>
                      <dd class="mt-1.5 text-[0.88rem] leading-relaxed text-warm line-through decoration-warm-light/60">{c.avant}</dd>
                    </div>
                    <div class="bg-white p-4">
                      <dt class="font-display text-[0.68rem] font-semibold uppercase tracking-wider text-teal">Ce que dit la source</dt>
                      <dd class="mt-1.5 text-[0.88rem] leading-relaxed text-ink-soft">{c.apres}</dd>
                    </div>
                  </dl>

                  <div class="mt-4 flex flex-wrap items-baseline gap-x-5 gap-y-2 text-[0.8rem]">
                    <a href={c.source.url} target="_blank" rel="noopener nofollow" class="font-medium text-teal-700 underline decoration-teal/30 underline-offset-4 hover:decoration-amber">
                      {c.source.label} ↗
                    </a>
                    {c.signalePar && (
                      <span class="ml-auto inline-flex items-center gap-1.5 rounded-full bg-amber-50 px-3 py-1 text-[0.76rem] font-medium text-amber-700">
                        <svg viewBox="0 0 16 16" class="h-3 w-3 shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M8 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6ZM2.5 14a5.5 5.5 0 0 1 11 0" />
                        </svg>
                        Signalé par {c.signalePar}
                      </span>
                    )}
                  </div>
                </div>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <Visuel page="/mises-a-jour" position="bande" seed="corrections-fin" accent="ink" class="!mt-16" />

      <div class="mt-10">
        <Newsletter variant="inline" title="Être prévenu quand une règle change" />
      </div>
    </div>

    <aside class="lg:sticky lg:top-24 lg:h-fit">
      <div class="rounded-brand border border-line bg-white p-6">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Pourquoi cette page existe</p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-warm">
          Les règles de visa en Asie changent plusieurs fois par an. La plupart des sites
          affichent une date de mise à jour sans jamais dire ce qui a bougé — ce qui revient
          à demander qu'on les croie sur parole.
        </p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-warm">
          Chaque mois, les neuf fiches pays sont recomparées aux portails officiels. Tout écart
          constaté est corrigé et publié ici, avec sa source.
        </p>
        <hr class="rule my-5" />
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Vous avez vu une erreur ?</p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-warm">
          C'est la partie la plus utile du courrier qu'on reçoit, et elle passe en priorité.
        </p>
        <a href={`mailto:${site.author.email}?subject=${encodeURIComponent('Information périmée sur Asia Unseen')}`} class="btn-outline mt-4 w-full !py-2.5 !text-[0.85rem]">
          Signaler une information
        </a>
      </div>
    </aside>
  </div>
</BaseLayout>
