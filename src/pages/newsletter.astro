---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Newsletter from '@/components/Newsletter.astro';
import Visuel from '@/components/Visuel.astro';
import { newsletter } from '@/data/site';
---

<BaseLayout
  title="La fiche de départ — une par pays d'Asie"
  description="Une fiche de départ par pays d'Asie : visa, numéros d'urgence, budget réel. Vérifiée aux sources officielles, et rééditée quand une règle change."
  noPopup
>
  <Visuel page="/newsletter" seed="newsletter" prioritaire />

  <section class="wrap grid gap-14 py-16 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:py-24">
    <div>
      <p class="eyebrow">Newsletter · gratuite</p>
      {/*
        Le saut de ligne ne vaut pas une espace : à l'écran le titre se lit sur
        deux lignes, mais son texte est « Neuf fiches,une par pays » — et c'est
        cette chaîne-là que lisent une synthèse vocale et un résultat de
        recherche.
      */}
      <h1 class="mt-4 text-hero">Neuf fiches, <br />une par pays</h1>
      <p class="mt-7 max-w-xl text-[1.15rem] leading-relaxed text-warm">
        Un document de dix pages, à garder sur le téléphone. Il répond à trois questions
        et pas une de plus : à qui téléphoner en cas d'urgence, ce qu'on a le droit de
        faire, ce que ça coûte. Il fonctionne sans réseau.
      </p>

      <ul class="mt-10 space-y-5">
        {[
          ["Les numéros d'urgence", "Police, pompiers, secours médicaux, et l'ambassade de France — relevés un par un sur les pages officielles, jamais de mémoire"],
          ["La règle d'entrée", 'Visa ou exemption, durée autorisée, coût réel : la règle telle que la publie le pays, à la date où elle a été relevée'],
          ['Le budget par jour', 'Trois niveaux, hors vol, pour savoir en une seconde si le voyage tient dans ce que vous avez'],
          ['Rééditée quand ça change', "C'est ce que personne d'autre ne fait : le site revérifie ces règles chaque matin, et vous renvoie la fiche corrigée quand l'une d'elles bouge"],
        ].map(([titre, desc]) => (
          <li class="flex gap-4">
            <svg viewBox="0 0 20 20" class="mt-1 h-4 w-4 shrink-0 text-amber" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3.5 10.5 8 15l8.5-10" />
            </svg>
            <div>
              <p class="font-display text-[1rem] font-semibold text-ink">{titre}</p>
              <p class="mt-1 text-[0.9rem] leading-relaxed text-warm">{desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="lg:sticky lg:top-24">
      <Newsletter title="Où faut-il les envoyer ?" />
      <Visuel page="/newsletter" position="bande" seed="newsletter-aside" accent="ink" class="!mt-6" />

      <div class="mt-6 rounded-brand border border-line bg-white p-6">
        <p class="font-display text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-warm-light">
          Ce à quoi vous vous engagez
        </p>
        <ul class="mt-4 space-y-2.5 text-[0.88rem] leading-relaxed text-warm">
          <li>Un email quand une règle change, pas pour meubler.</li>
          <li>{newsletter.promise}</li>
          <li>Votre adresse n'est ni revendue ni partagée. <a href="/confidentialite" class="link">Notre politique</a>.</li>
        </ul>
      </div>
    </div>
  </section>
</BaseLayout>
