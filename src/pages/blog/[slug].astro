---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import { articlesPublies, suggestionsCroisees } from '@/lib/articles';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Disclosure from '@/components/Disclosure.astro';
import RedactionAuto from '@/components/RedactionAuto.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Newsletter from '@/components/Newsletter.astro';
import AdSlot from '@/components/AdSlot.astro';
import FAQ from '@/components/FAQ.astro';
import VerifiedBadge from '@/components/VerifiedBadge.astro';
import Visuel from '@/components/Visuel.astro';
import { bySlug } from '@/data/countries';
import { site } from '@/data/site';

export const getStaticPaths = (async () => {
  const posts = await articlesPublies();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}) satisfies GetStaticPaths;

const { post, posts } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const d = post.data;

const readingTime = d.tempsLecture ?? remarkPluginFrontmatter?.minutes ?? null;
const toc = headings.filter((h) => h.depth === 2);
const paysLies = d.pays.map((s) => bySlug[s]).filter(Boolean);

// Suggestions : pertinentes d'abord, mais réparties — voir la note dans
// src/lib/articles.ts sur les articles qui ne recevaient jamais de lien.
const suite = (await suggestionsCroisees()).get(post.id) ?? [];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: d.heading ?? d.title,
    description: d.description,
    inLanguage: 'fr-FR',
    datePublished: d.pubDate.toISOString(),
    dateModified: (d.updatedDate ?? d.pubDate).toISOString(),
    author: { '@type': 'Person', name: site.author.name, url: `${site.url}/a-propos` },
    publisher: { '@id': `${site.url}/#organization` },
    mainEntityOfPage: { '@type': 'WebPage', '@id': `${site.url}/blog/${post.id}` },
  },
];

const fmt = (date: Date) =>
  new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(date);
---

<BaseLayout
  title={d.title}
  description={d.description}
  type="article"
  image={d.image ?? `/og/blog/${post.id}.png`}
  publishedTime={d.pubDate}
  modifiedTime={d.updatedDate ?? d.pubDate}
  schema={schema}
>
  <article>
    <header class="border-b border-line bg-cream-warm">
      <div class="wrap py-10 lg:py-14">
        <Breadcrumbs items={[{ href: '/blog', label: 'Articles' }, { label: d.heading ?? d.title }]} />
        <h1 class="mt-6 max-w-3xl text-hero">{d.heading ?? d.title}</h1>
        <p class="mt-6 max-w-2xl text-[1.15rem] leading-relaxed text-warm">{d.accroche}</p>
        <p class="mt-6 text-[0.82rem] text-warm-light">
          Par {site.author.name} · {fmt(d.pubDate)}
          {d.updatedDate && <> · mis à jour le {fmt(d.updatedDate)}</>}
          {readingTime && <> · {readingTime} min de lecture</>}
        </p>
      </div>
    </header>

    <Visuel page={`/blog/${post.id}`} seed={post.id} accent={d.pays.includes('japon') || d.pays.includes('coree-du-sud') ? 'ink' : 'teal'} prioritaire />

    <div class="wrap grid gap-14 py-14 lg:grid-cols-[minmax(0,1fr)_18rem] lg:gap-16">
      <div class="prose-au min-w-0">
        <Disclosure compact class="!mb-10 !mt-0" />
        {/*
          En tête d'article, avant le texte : le lecteur doit savoir comment
          l'article a été écrit avant de le lire, pas après l'avoir cru.
        */}
        {d.redactionAutomatique && <RedactionAuto sources={d.sources.length} class="!mb-10" />}
        <Content />
        <AdSlot placement="in-article" />

        {d.sources.length > 0 && (
          <VerifiedBadge
            date={`${(d.updatedDate ?? d.pubDate).getFullYear()}-${String((d.updatedDate ?? d.pubDate).getMonth() + 1).padStart(2, '0')}`}
            sources={d.sources}
            page={`/blog/${post.id}`}
            class="!my-10"
          />
        )}

        <FAQ items={d.faq} />

        {paysLies.length > 0 && (
          <p class="not-prose mt-14 flex flex-wrap items-center gap-2.5 text-[0.85rem] text-warm">
            Guides liés :
            {paysLies.map((p) => (
              <a href={`/${p.slug}`} class="chip !px-3.5 !py-1.5 transition-colors hover:border-teal hover:text-teal">{p.nom}</a>
            ))}
          </p>
        )}

        <Newsletter variant="inline" />
      </div>

      <aside data-pagefind-ignore class="lg:sticky lg:top-24 lg:h-fit">
        {toc.length > 0 && (
          <nav aria-label="Sommaire" class="rounded-brand border border-line bg-white p-5">
            <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Sur cette page</p>
            <ul class="mt-4 space-y-2.5 text-[0.88rem]">
              {toc.map((h) => (
                <li><a href={`#${h.slug}`} class="text-warm transition-colors hover:text-teal">{h.text}</a></li>
              ))}
            </ul>
          </nav>
        )}
        <AdSlot placement="sidebar" class="!mt-6" />
      </aside>
    </div>

    <Visuel page={`/blog/${post.id}`} position="bande" seed={`${post.id}-fin`} accent="ink" />

    {suite.length > 0 && (
      <section data-pagefind-ignore class="border-t border-line bg-cream-warm">
        <div class="wrap py-16">
          <h2 class="text-title">À lire ensuite</h2>
          <div class="mt-4 h-[3px] w-12 bg-amber"></div>
          <div class="mt-10 grid gap-5 sm:grid-cols-3">
            {suite.map((p) => (
              <ArticleCard
                href={`/blog/${p.id}`}
                title={p.data.heading ?? p.data.title}
                accroche={p.data.accroche}
                date={p.data.pubDate}
              />
            ))}
          </div>
        </div>
      </section>
    )}
  </article>
</BaseLayout>
