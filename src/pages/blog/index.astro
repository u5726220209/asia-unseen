---
import { getCollection } from 'astro:content';
import { articlesPublies } from '@/lib/articles';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Visuel from '@/components/Visuel.astro';
import Newsletter from '@/components/Newsletter.astro';
import AdSlot from '@/components/AdSlot.astro';

const posts = (await articlesPublies()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

const LABELS: Record<string, string> = {
  recit: 'Récit', pratique: 'Pratique', itineraire: 'Itinéraire', argent: 'Argent',
};

const [featured, ...rest] = posts;
---

<BaseLayout
  title="Articles pratiques — voyager en Asie"
  description="Formalités, budgets, transports et hébergement en Asie : chaque fait vérifié à sa source officielle, avec sa date de relevé, pays par pays."
>
  <header class="border-b border-line bg-cream-warm">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs items={[{ label: 'Articles' }]} />
      <h1 class="mt-6 max-w-3xl text-hero">Les articles</h1>
      <p class="mt-6 max-w-2xl text-[1.15rem] leading-relaxed text-warm">
        Formalités, budgets, transports, hébergement : ce qu'il faut décider avant de
        partir, avec la source officielle de chaque affirmation et sa date de relevé.
      </p>
    </div>
  </header>

  <Visuel page="/blog" seed="blog" prioritaire accent="teal" />

  <div class="wrap py-14">
    {posts.length === 0 && (
      <p class="py-20 text-center text-warm">
        Les premiers articles arrivent. En attendant, les
        <a href="/ressources" class="link">guides pratiques</a> sont déjà en ligne.
      </p>
    )}

    {featured && (
      <div class="mb-14">
        <ArticleCard
          niveau={2}
          featured
          href={`/blog/${featured.id}`}
          title={featured.data.heading ?? featured.data.title}
          accroche={featured.data.accroche}
          date={featured.data.pubDate}
          meta={`Dernier article · ${LABELS[featured.data.categorie]}`}
        />
      </div>
    )}

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {rest.map((p) => (
        <ArticleCard
          niveau={2}
          href={`/blog/${p.id}`}
          title={p.data.heading ?? p.data.title}
          accroche={p.data.accroche}
          date={p.data.pubDate}
          meta={LABELS[p.data.categorie]}
        />
      ))}
    </div>

    <Visuel page="/blog" position="bande" seed="blog-fin" accent="ink" class="!mt-14" />
    <AdSlot placement="in-feed" />
    <Newsletter class="mt-16" />
  </div>
</BaseLayout>
