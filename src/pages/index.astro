---
import { getCollection } from 'astro:content';
import { articlesPublies, guidesPublies } from '@/lib/articles';
import BaseLayout from '@/layouts/BaseLayout.astro';
import CountryCard from '@/components/CountryCard.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Newsletter from '@/components/Newsletter.astro';
import Testimonials from '@/components/Testimonials.astro';
import AdSlot from '@/components/AdSlot.astro';
import Visuel from '@/components/Visuel.astro';
import { countries } from '@/data/countries';
import { guidesNav } from '@/data/nav';
import { site } from '@/data/site';
import { plusAncienneVerification, queMois } from '@/lib/fraicheur';
import { nbCorrections } from '@/data/corrections';

const guides = (await guidesPublies()).sort(
  (a, b) => a.data.ordre - b.data.ordre,
);
const allPosts = (await articlesPublies()).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const posts = allPosts.slice(0, 4);

// Chiffres réels, calculés à partir du contenu publié — jamais arrondis à la hausse.
const nbPages = guides.length + countries.length + allPosts.length;
const nbPays = countries.length;
// La date affichée se déduit des fiches elles-mêmes, et c'est la plus
// ancienne : « aucune fiche n'est plus vieille que » se vérifie, « mis à jour
// en » ne se vérifie pas. Voir src/lib/fraicheur.ts.
const majLabel = queMois(plusAncienneVerification);

const problemes = [
  {
    probleme: 'Les formalités changent tous les six mois',
    solution:
      "Chaque fiche visa porte une date de vérification et les liens vers les portails gouvernementaux. Quand une règle bouge, la page bouge — et la date le dit.",
  },
  {
    probleme: 'Les « top 10 » recopient tous la même source, jamais vérifiée',
    solution:
      "Ici, aucune recommandation n'est reprise d'un autre blog. Les faits datés viennent des portails officiels, les prix des opérateurs, et les sources sont citées en bas de page pour que vous puissiez vérifier.",
  },
  {
    probleme: 'Les budgets annoncés sont irréalistes',
    solution:
      "Nos fourchettes viennent de dépenses tenues au jour le jour, poste par poste, dans trois styles de voyage. Le calculateur les applique à votre itinéraire.",
  },
  {
    probleme: 'On ne sait jamais qui touche quoi',
    solution:
      "Les liens partenaires sont signalés en haut de page, en clair. On recommande aussi des services qui ne nous rapportent rien quand ils sont meilleurs.",
  },
];
---

<BaseLayout
  title="Guides de voyage en Asie : visas, budgets, itinéraires"
  description="Guides de voyage en Asie écrits à partir de sources officielles : visas, budgets réels, transports et erreurs à éviter dans neuf pays."
>
  <!-- ═══ ATTENTION ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden border-b border-line bg-cream">
    <div class="wrap grid gap-14 py-20 lg:grid-cols-[1.15fr_0.85fr] lg:items-center lg:py-28">
      <div class="animate-rise">
        <p class="eyebrow">{nbPays} pays · {nbPages} guides et articles · aucune fiche plus ancienne {majLabel}</p>

        <h1 class="mt-5 text-hero">
          L'Asie comme vous ne<br class="hidden sm:block" />
          l'avez <span class="relative inline-block">
            jamais vue
            <svg viewBox="0 0 200 12" preserveAspectRatio="none" class="absolute -bottom-1 left-0 h-2.5 w-full text-amber" aria-hidden="true">
              <path d="M2 8c40-5 90-7 196-4" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
            </svg>
          </span>
        </h1>

        <p class="mt-8 max-w-xl text-[1.15rem] leading-relaxed text-warm">
          Des guides pratiques vérifiés aux sources officielles : visas, budgets réels, transports,
          où dormir, et surtout les erreurs qui coûtent cher. Pas de liste de « lieux
          incontournables » recopiée d'un office de tourisme.
        </p>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:items-center">
          <a href="/newsletter" class="btn-primary">Recevoir les fiches (gratuit)</a>
          <a href="#destinations" class="btn-outline">Explorer les {nbPays} pays</a>
        </div>

        <p class="mt-6 text-[0.85rem] text-warm-light">
          Sans spam : un email quand une règle officielle change, rien entre-temps.
        </p>
      </div>

      <!-- Panneau « preuve » : des faits vérifiables, pas des badges décoratifs -->
      <aside class="rounded-brand border border-line bg-white p-8 shadow-lift">
        <p class="font-display text-[0.75rem] font-semibold uppercase tracking-[0.16em] text-teal">
          Ce que ce site fait différemment
        </p>
        <ul class="mt-6 space-y-5">
          {[
            ['Vérifié à la source', "Chaque règle de visa est relevée sur le portail du pays concerné, jamais recopiée d'un autre blog. Les sources sont citées et cliquables."],
            ['Daté, donc vérifiable', 'Chaque page de formalités affiche sa date de dernière vérification et ses sources officielles.'],
            ['Transparent sur l\'argent', "Les liens partenaires sont annoncés en haut de page. On dit aussi quand un service ne vaut pas son prix."],
          ].map(([titre, texte]) => (
            <li class="flex gap-4">
              <svg viewBox="0 0 20 20" class="mt-0.5 h-5 w-5 shrink-0 text-amber" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3.5 10.5 8 15l8.5-10" />
              </svg>
              <div>
                <p class="font-display text-[0.95rem] font-semibold text-ink">{titre}</p>
                <p class="mt-1 text-[0.88rem] leading-relaxed text-warm">{texte}</p>
              </div>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  <Visuel page="/" seed="accueil" prioritaire />

  <!-- ═══ INTÉRÊT — les destinations ══════════════════════════ -->
  <section id="destinations" class="wrap scroll-mt-24 py-20 lg:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl">
        <p class="eyebrow">Destinations</p>
        <h2 class="mt-3 text-display">Neuf pays, neuf guides complets</h2>
        <p class="mt-4 text-[1.05rem] leading-relaxed text-warm">
          Formalités, budget par jour, meilleure saison mois par mois, incontournables,
          hors sentiers battus et erreurs à éviter. Tout est sur une seule page par pays.
        </p>
      </div>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {countries.map((c) => <CountryCard country={c} />)}
    </div>
  </section>

  <!-- ═══ INTÉRÊT — problème / solution ═══════════════════════ -->
  <section class="border-y border-line bg-cream-warm">
    <div class="wrap py-20 lg:py-24">
      <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="eyebrow">Pourquoi ce site existe</p>
          <h2 class="mt-3 text-display">
            Préparer un voyage en Asie est devenu absurdement compliqué
          </h2>
          <p class="mt-6 text-[1.05rem] leading-relaxed text-warm">
            Pas parce que l'information manque — parce qu'elle est partout, contradictoire,
            périmée et souvent écrite pour placer un lien. On a fait l'inverse.
          </p>
          <a href="/a-propos" class="link mt-8 inline-block">Qui écrit ces guides, et pourquoi</a>
        </div>

        <ul class="grid gap-px overflow-hidden rounded-brand border border-line bg-line sm:grid-cols-2">
          {problemes.map((p) => (
            <li class="bg-cream-warm p-7">
              <p class="font-display text-[1.02rem] font-semibold leading-snug text-ink">{p.probleme}</p>
              <div class="mt-3 h-[3px] w-8 bg-amber"></div>
              <p class="mt-3 text-[0.92rem] leading-relaxed text-warm">{p.solution}</p>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ═══ DÉSIR — les guides pratiques ════════════════════════ -->
  <section class="wrap py-20 lg:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">Guides pratiques</p>
      <h2 class="mt-3 text-display">Les dix questions qui reviennent toujours</h2>
      <p class="mt-4 text-[1.05rem] leading-relaxed text-warm">
        Avec deux outils qui répondent à votre place : un calculateur de budget et un
        sélecteur de saison, mois par mois.
      </p>
    </div>

    <div class="mt-12 grid gap-px overflow-hidden rounded-brand border border-line bg-line sm:grid-cols-2 lg:grid-cols-3">
      {guidesNav.map((g, i) => (
        <a href={g.href} class="group bg-white p-7 transition-colors hover:bg-teal-50">
          <span class="font-display text-[0.72rem] font-semibold tracking-[0.14em] text-warm-light">
            {String(i + 1).padStart(2, '0')}
          </span>
          <p class="mt-3 font-display text-[1.1rem] font-bold text-ink transition-colors group-hover:text-teal">
            {g.label}
          </p>
          <p class="mt-2 text-[0.88rem] leading-relaxed text-warm">{g.hint}</p>
        </a>
      ))}
    </div>
  </section>

  <AdSlot placement="in-feed" class="wrap" />

  <Visuel page="/" position="bande" seed="accueil-auteur" accent="teal" invert />

  <!-- ═══ DÉSIR — crédibilité de l'auteur ═════════════════════ -->
  <section class="border-y border-line bg-ink">
    <div class="wrap grid gap-12 py-20 lg:grid-cols-[1fr_1.1fr] lg:items-center lg:py-24">
      <div>
        <p class="eyebrow !text-amber">L'auteur</p>
        <blockquote class="mt-6 font-accent text-[1.75rem] leading-[1.35] text-cream sm:text-[2rem]">
          « Une information de voyage sans date est une information morte. Chaque règle publiée
          ici a été relevée sur le portail du pays concerné, datée, et corrigée quand elle change —
          en disant ce qui a changé. Le journal des corrections est public : c'est la seule preuve
          qui vaille. »
        </blockquote>
        <p class="mt-8 font-display text-[0.9rem] font-semibold text-cream">{site.author.name}</p>
        <p class="text-[0.85rem] text-warm">{site.author.role}</p>
        <a href="/mises-a-jour" class="mt-5 inline-block text-[0.85rem] font-medium text-amber underline decoration-amber/40 underline-offset-4 hover:decoration-amber">
          Voir les {nbCorrections} corrections publiées →
        </a>
      </div>

      <dl class="grid grid-cols-2 gap-px overflow-hidden rounded-brand bg-white/10 sm:grid-cols-2">
        {[
          [`${nbPays}`, 'pays documentés en détail', null],
          [`${nbPages}`, 'guides, fiches et articles publiés', null],
          [`${nbCorrections}`, 'corrections publiées, avec leur source', '/mises-a-jour'],
          ['0 €', 'de contenu sponsorisé déguisé', '/affiliation'],
        ].map(([chiffre, label, href]) => (
          <div class="bg-ink p-8">
            <dt class="font-display text-[2.6rem] font-bold leading-none tracking-tight text-amber">{chiffre}</dt>
            <dd class="mt-2 text-[0.85rem] leading-snug text-warm-light">
              {href ? (
                <a href={href} class="underline decoration-white/20 underline-offset-4 transition-colors hover:text-cream hover:decoration-amber">{label}</a>
              ) : label}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Testimonials />

  <!-- ═══ DÉSIR — derniers articles ════════════════════════════ -->
  {posts.length > 0 && (
    <section class="wrap py-20 lg:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-xl">
          <p class="eyebrow">Publié récemment</p>
          <h2 class="mt-3 text-display">Les derniers articles</h2>
        </div>
        <a href="/blog" class="btn-outline">Tous les articles</a>
      </div>
      <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {posts.map((p) => (
          <ArticleCard
            href={`/blog/${p.id}`}
            title={p.data.heading ?? p.data.title}
            accroche={p.data.accroche}
            date={p.data.pubDate}
          />
        ))}
      </div>
    </section>
  )}

  <!-- ═══ ACTION ══════════════════════════════════════════════ -->
  <div class="wrap pb-24">
    <Newsletter />
  </div>
</BaseLayout>
