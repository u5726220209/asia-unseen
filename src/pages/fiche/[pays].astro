---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { countries } from '@/data/countries';
import { site } from '@/data/site';

export function getStaticPaths() {
  return countries.map((c) => ({ params: { pays: c.slug }, props: { c } }));
}

const { c } = Astro.props;

const moisFr = (v: string) => {
  const [a, m] = v.split('-');
  const noms = ['janvier','février','mars','avril','mai','juin','juillet','août','septembre','octobre','novembre','décembre'];
  return m ? `${noms[+m - 1]} ${a}` : v;
};

/** Une phrase courte : sur papier, la nuance se lit mal et la longueur coûte une page. */
const court = (t: string) => t.split(/(?<=\.)\s/)[0];
---

<BaseLayout
  title={`Fiche ${c.nom} à emporter : urgences, visa, ambassade`}
  description={`La fiche pratique ${c.nom} à imprimer : numéros de secours, coordonnées de l'ambassade de France, règle de visa et durée autorisée. Vérifiée en ${moisFr(c.verifieLe)}.`}
>
  <div data-no-print>
    <header class="border-b border-line bg-cream-warm">
      <div class="wrap py-10 lg:py-14">
        <Breadcrumbs items={[{ label: c.nom, href: `/${c.slug}` }, { label: 'Fiche à emporter' }]} />
        <h1 class="mt-6 max-w-3xl text-hero">La fiche {c.nom}, à emporter</h1>
        <p class="mt-6 max-w-2xl text-[1.15rem] leading-relaxed text-warm">
          Une page, à imprimer et à glisser dans le passeport. Les numéros de secours, l'ambassade,
          la règle de visa. Ce qu'on cherche quand le téléphone n'a plus de batterie.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <button type="button" data-imprimer class="btn-primary">Imprimer cette fiche</button>
          <a href={`/${c.slug}`} class="btn-ghost">Retour au guide {c.nom}</a>
        </div>
      </div>
    </header>
  </div>

  <div class="wrap py-10 print:py-0">
    <article class="au-fiche mx-auto max-w-[46rem] rounded-brand border border-line bg-white p-8 print:max-w-none print:rounded-none print:border-0 print:p-0">
      <header class="flex flex-wrap items-baseline justify-between gap-3 border-b-2 border-ink pb-4">
        <div>
          <p class="font-display text-[0.7rem] uppercase tracking-[0.2em] text-warm-light">Fiche pratique · Asia Unseen</p>
          <p class="mt-1 font-display text-[2rem] font-bold leading-none text-ink">{c.nom}</p>
        </div>
        <p class="text-[0.8rem] text-warm-light">Vérifiée en {moisFr(c.verifieLe)}</p>
      </header>

      <section class="mt-6 break-inside-avoid">
        <h2 class="font-display text-[0.78rem] font-semibold uppercase tracking-wider text-warm-light">En cas d'urgence</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2">
          {c.urgences.numeros.map((n) => (
            <li class="flex items-baseline justify-between gap-4 border-b border-line pb-1.5">
              <span class="text-[0.92rem] text-warm">{n.label}</span>
              <span class="font-display text-[1.2rem] font-bold tabular-nums text-ink">{n.numero}</span>
            </li>
          ))}
        </ul>
      </section>

      <section class="mt-6 break-inside-avoid">
        <h2 class="font-display text-[0.78rem] font-semibold uppercase tracking-wider text-warm-light">Ambassade de France</h2>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink">
          {c.urgences.ambassade.adresse}
        </p>
        <p class="mt-1 font-display text-[1.15rem] font-bold tabular-nums text-ink">{c.urgences.ambassade.telephone}</p>
      </section>

      <section class="mt-6 break-inside-avoid">
        <h2 class="font-display text-[0.78rem] font-semibold uppercase tracking-wider text-warm-light">Entrée sur le territoire</h2>
        <p class="mt-2 text-[0.95rem] leading-relaxed text-ink">{c.visa.resume}</p>
        <dl class="mt-3 grid gap-x-6 gap-y-1.5 sm:grid-cols-2">
          <div class="flex justify-between gap-4 border-b border-line pb-1.5">
            <dt class="text-[0.88rem] text-warm">Durée autorisée</dt>
            <dd class="text-right text-[0.88rem] font-semibold text-ink">{court(c.visa.duree)}</dd>
          </div>
          <div class="flex justify-between gap-4 border-b border-line pb-1.5">
            <dt class="text-[0.88rem] text-warm">Coût officiel</dt>
            <dd class="text-right text-[0.88rem] font-semibold text-ink">{court(c.visa.cout)}</dd>
          </div>
        </dl>
      </section>

      <section class="mt-6 grid gap-x-6 gap-y-1.5 break-inside-avoid sm:grid-cols-2">
        {[
          ['Capitale', c.capitale],
          ['Monnaie', c.monnaie],
          ['Décalage horaire', c.decalage],
          ['Depuis Paris', c.volDepuisParis],
        ].map(([k, v]) => (
          <div class="flex justify-between gap-4 border-b border-line pb-1.5">
            <span class="text-[0.88rem] text-warm">{k}</span>
            <span class="text-right text-[0.88rem] font-semibold text-ink">{v}</span>
          </div>
        ))}
      </section>

      <section class="mt-6 break-inside-avoid">
        <h2 class="font-display text-[0.78rem] font-semibold uppercase tracking-wider text-warm-light">Les trois erreurs qui coûtent le plus cher</h2>
        <ol class="mt-2 space-y-1.5">
          {c.erreurs.slice(0, 3).map((e) => (
            <li class="flex gap-2.5 text-[0.9rem] leading-relaxed text-ink">
              <span class="font-display font-bold text-warm-light">·</span><span>{e}</span>
            </li>
          ))}
        </ol>
      </section>

      <footer class="mt-7 border-t border-line pt-3 text-[0.74rem] leading-relaxed text-warm-light">
        <p>
          Numéros relevés sur <span class="font-medium">{c.urgences.source.label}</span>. Les règles
          d'entrée changent sans préavis : avant de partir, vérifiez la source officielle.
        </p>
        <p class="mt-1">
          {site.url}/{c.slug} · fiche vérifiée en {moisFr(c.verifieLe)} · corrections publiées sur {site.url}/mises-a-jour
        </p>
      </footer>
    </article>
  </div>

  <div data-no-print class="wrap-narrow pb-14">
    <div class="prose-au">
      <h2>Pourquoi une fiche papier en 2026</h2>
      <p>
        Parce que le moment où l'on a besoin d'un numéro de secours est souvent celui où le
        téléphone est déchargé, volé, ou sans réseau. Une feuille pliée dans le passeport ne
        tombe jamais en panne.
      </p>
      <p>
        Les numéros ci-dessus sont relevés un par un sur les pages « Contacts utiles » de France
        Diplomatie et les sites des ambassades — jamais de mémoire. Là où la source officielle ne
        publie pas de numéro pour une catégorie, la fiche n'en invente pas : une donnée d'urgence
        fausse est pire qu'une donnée absente.
      </p>
      <p>
        Ces informations sont aussi disponibles <a href="/donnees">en accès libre</a>, et le détail
        complet du pays se trouve dans le <a href={`/${c.slug}`}>guide {c.nom}</a>.
      </p>
    </div>

    {/*
      Le PDF des neuf fiches, à télécharger d'un clic.
      Il existait sans être lié : un document que personne ne peut atteindre
      n'a aucune valeur, si bon soit-il.
    */}
    <a
      href="/telechargements/fiches-depart-asie.pdf"
      download
      class="not-prose mt-10 flex items-center gap-4 rounded-brand border border-line bg-cream-warm px-5 py-4 transition-colors hover:border-teal"
    >
      <svg viewBox="0 0 24 24" class="h-8 w-8 shrink-0 text-teal" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v12m0 0-4-4m4 4 4-4" /><path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2" />
      </svg>
      <span>
        <span class="block font-display text-[0.98rem] font-semibold text-ink">
          Les neuf fiches en un seul PDF
        </span>
        <span class="mt-0.5 block text-[0.86rem] leading-relaxed text-warm">
          Une page par pays : urgences, ambassade, visa, budget. À garder sur le téléphone,
          il fonctionne sans réseau.
        </span>
      </span>
    </a>
  </div>
</BaseLayout>

<style is:global>
  @media print {
    [data-no-print],
    body > header,
    body > div:has(> header[class*='sticky']),
    body > div[data-pagefind-ignore] { display: none !important; }
    body { background: #fff; }
    .au-fiche { box-shadow: none; }
    @page { size: A4; margin: 14mm; }
  }
</style>

<script is:inline>
  document.querySelector('[data-imprimer]')?.addEventListener('click', () => {
    try { window.gtag?.('event', 'tool_use', { outil: 'fiche-a-emporter' }); } catch {}
    window.print();
  });
</script>
