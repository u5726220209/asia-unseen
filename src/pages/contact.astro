---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Visuel from '@/components/Visuel.astro';
import { site } from '@/data/site';

/*
 * Le formulaire de contact n'a volontairement pas de backend : son attribut
 * `action` reste vide tant qu'aucun service (Formspree, Web3Forms, une fonction
 * Cloudflare…) n'est branché, et le script de bas de page renvoie alors vers
 * l'adresse email. Ce commentaire vivait dans le HTML, donc dans la source que
 * lit le visiteur ; il n'a rien à y faire.
 */
---

<BaseLayout
  title="Contact — une question, une correction, une proposition"
  description="Écrivez-nous : corrections d'informations périmées, questions sur un itinéraire, propositions de partenariat ou demandes presse."
  noPopup
>
  <header class="border-b border-line bg-cream-warm">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs items={[{ label: 'Contact' }]} />
      <h1 class="mt-6 text-hero">Nous écrire</h1>
      <p class="mt-6 max-w-2xl text-[1.15rem] leading-relaxed text-warm">
        Réponse sous 3 à 5 jours ouvrés. Les signalements d'erreurs passent en priorité.
      </p>
    </div>
  </header>

  <Visuel page="/contact" seed="contact" prioritaire accent="ink" />

  <div class="wrap grid gap-14 py-14 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <form
        id="au-contact" method="POST" data-adresse={site.author.email}
        class="grid gap-5 rounded-brand border border-line bg-white p-7 sm:p-9"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="c-nom" class="mb-2 block font-display text-[0.8rem] font-semibold uppercase tracking-wider text-ink">Votre nom</label>
            <input id="c-nom" name="nom" type="text" required autocomplete="name"
              class="w-full rounded-brand border border-line bg-cream px-4 py-3 text-ink focus:border-teal focus:outline-none" />
          </div>
          <div>
            <label for="c-mail" class="mb-2 block font-display text-[0.8rem] font-semibold uppercase tracking-wider text-ink">Votre email</label>
            <input id="c-mail" name="email" type="email" required autocomplete="email"
              class="w-full rounded-brand border border-line bg-cream px-4 py-3 text-ink focus:border-teal focus:outline-none" />
          </div>
        </div>

        <div>
          <label for="c-sujet" class="mb-2 block font-display text-[0.8rem] font-semibold uppercase tracking-wider text-ink">Sujet</label>
          <select id="c-sujet" name="sujet" class="w-full rounded-brand border border-line bg-cream px-4 py-3 text-ink focus:border-teal focus:outline-none">
            <option>Signaler une information périmée ou fausse</option>
            <option>Question sur un itinéraire</option>
            <option>Proposition de partenariat</option>
            <option>Demande presse</option>
            <option>Autre</option>
          </select>
        </div>

        <div>
          <label for="c-msg" class="mb-2 block font-display text-[0.8rem] font-semibold uppercase tracking-wider text-ink">Votre message</label>
          <textarea id="c-msg" name="message" rows="7" required
            class="w-full rounded-brand border border-line bg-cream px-4 py-3 text-ink focus:border-teal focus:outline-none"
            placeholder="Si vous signalez une erreur, indiquez la page et ce qui a changé — ça nous fait gagner beaucoup de temps."></textarea>
        </div>

        <!-- Piège à robots : un champ invisible que seuls les scripts remplissent. -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <div>
          <button type="submit" class="btn-primary">Préparer le message</button>
          <p class="mt-3 text-[0.82rem] leading-relaxed text-warm">
            Ce formulaire n'envoie rien lui-même : il ouvre votre messagerie avec le message
            déjà rédigé. Rien ne quitte votre navigateur avant que vous n'appuyiez sur envoyer,
            et aucun service tiers ne voit ce que vous écrivez.
          </p>
          <div id="au-contact-msg" class="mt-4 hidden" role="status"></div>
        </div>
      </form>
    </div>

    <aside class="space-y-6">
      <div class="rounded-brand border border-line bg-white p-6">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Par email</p>
        <a href={`mailto:${site.author.email}`} class="link mt-3 block font-display text-[1.05rem]">{site.author.email}</a>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-warm">
          Le plus direct. Pour une correction, mettez l'URL de la page en objet.
        </p>
      </div>

      <div class="rounded-brand border border-line bg-white p-6">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Partenariats</p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-warm">
          Nous acceptons des collaborations à deux conditions : le service doit être testé au
          préalable, et la mention doit être visible pour le lecteur. Nous refusons les liens
          insérés dans du contenu existant et les articles rédigés par l'annonceur.
        </p>
      </div>

      <Visuel page="/contact" position="bande" seed="contact-aside" accent="ink" class="!rounded-brand" />

      <div class="rounded-brand border-l-[3px] border-amber bg-amber-50 p-6">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-amber-700">Ce qu'on ne peut pas faire</p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          Nous ne pouvons pas vérifier votre dossier de visa, ni vous garantir une décision
          consulaire. Pour tout ce qui est officiel, adressez-vous à l'ambassade concernée.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  /**
   * Le formulaire compose le message, il ne l'envoie pas.
   *
   * Il demandait cinq champs, une case RGPD et un piège à robots — puis
   * n'envoyait rien : deux minutes de saisie récompensées par une ligne de
   * texte renvoyant à l'adresse e-mail. Sur un site qui fait de l'honnêteté
   * son argument, c'était le pire endroit possible pour un faux-semblant.
   *
   * Le brancher sur un service d'envoi demanderait un compte tiers, une
   * dépendance et une surface de données supplémentaire. Or le formulaire a
   * une valeur propre, indépendante de l'envoi : il dit quoi écrire. On la
   * garde, et on laisse la messagerie du visiteur faire ce qu'elle sait faire.
   *
   * Conséquence heureuse : rien ne transite par un tiers, et le message
   * n'existe que dans le brouillon de son auteur tant qu'il ne l'envoie pas.
   *
   * Le repli compte autant que le geste principal : une messagerie non
   * configurée n'ouvre rien, et le visiteur croirait avoir écrit dans le vide.
   * Le message composé s'affiche donc aussi à l'écran, copiable en un clic.
   */
  const form = document.getElementById('au-contact') as HTMLFormElement | null;
  const zone = document.getElementById('au-contact-msg');
  const ADRESSE = (document.getElementById('au-contact') as HTMLElement | null)?.dataset.adresse ?? '';

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (!zone) return;

    const val = (n: string) =>
      (form.querySelector<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(`[name="${n}"]`)?.value ?? '').trim();

    // Le piège à robots : rempli, on ne fait rien et on ne le dit pas.
    if (val('_gotcha')) return;

    const sujet = val('sujet') || 'Message depuis le site';
    const corps = [
      val('message'),
      '',
      '—',
      val('nom'),
      val('email'),
      `Envoyé depuis ${location.origin}${location.pathname}`,
    ].join('\n');

    const lien = `mailto:${ADRESSE}?subject=${encodeURIComponent(sujet)}&body=${encodeURIComponent(corps)}`;

    zone.innerHTML = '';
    zone.classList.remove('hidden');

    const p = document.createElement('p');
    p.className = 'text-[0.9rem] leading-relaxed text-ink-soft';
    p.textContent = 'Votre messagerie devrait s\'ouvrir avec le message prêt. Si rien ne se passe, copiez-le et envoyez-le à ' + ADRESSE + '.';
    zone.appendChild(p);

    const pre = document.createElement('pre');
    pre.className = 'mt-3 max-h-56 overflow-auto whitespace-pre-wrap rounded-brand border border-line bg-cream-warm p-4 text-[0.82rem] leading-relaxed text-ink-soft';
    pre.textContent = `À : ${ADRESSE}\nObjet : ${sujet}\n\n${corps}`;
    zone.appendChild(pre);

    const bouton = document.createElement('button');
    bouton.type = 'button';
    bouton.className = 'btn-outline mt-3 !py-2.5 !text-[0.85rem]';
    bouton.textContent = 'Copier le message';
    bouton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(pre.textContent ?? '');
        bouton.textContent = 'Copié';
      } catch {
        // Presse-papiers refusé : le texte reste sélectionnable au-dessus.
        bouton.textContent = 'Sélectionnez le texte ci-dessus';
      }
    });
    zone.appendChild(bouton);

    window.location.href = lien;
  });
</script>
