---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import HorizonBand from '@/components/HorizonBand.astro';
import { site } from '@/data/site';
---

<BaseLayout
  title="Contact — une question, une correction, une proposition"
  description="Écrivez-nous : corrections d'informations périmées, questions sur un itinéraire, propositions de partenariat ou demandes presse."
  noPopup
>
  <header class="border-b border-line bg-cream-warm">
    <div class="wrap py-10 lg:py-14">
      <Breadcrumbs items={[{ label: 'Contact' }]} />
      <h1 class="mt-6 text-hero">Nous écrire</h1>
      <p class="mt-6 max-w-2xl text-[1.15rem] leading-relaxed text-warm">
        Réponse sous 3 à 5 jours ouvrés. Les signalements d'erreurs passent en priorité.
      </p>
    </div>
  </header>

  <HorizonBand seed="contact" accent="ink" />

  <div class="wrap grid gap-14 py-14 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <!--
        Formulaire volontairement sans backend : voir README → « Brancher le formulaire ».
        Il suffit de renseigner l'attribut `action` avec un service (Formspree, Web3Forms,
        Cloudflare Pages Functions…). Sans action, le lien mailto sert de repli.
      -->
      <form
        id="au-contact" method="POST"
        class="grid gap-5 rounded-brand border border-line bg-white p-7 sm:p-9"
      >
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label for="c-nom" class="mb-2 block font-display text-[0.8rem] font-semibold uppercase tracking-wider text-ink">Votre nom</label>
            <input id="c-nom" name="nom" type="text" required autocomplete="name"
              class="w-full rounded-brand border border-line bg-cream px-4 py-3 text-ink focus:border-teal focus:outline-none" />
          </div>
          <div>
            <label for="c-mail" class="mb-2 block font-display text-[0.8rem] font-semibold uppercase tracking-wider text-ink">Votre email</label>
            <input id="c-mail" name="email" type="email" required autocomplete="email"
              class="w-full rounded-brand border border-line bg-cream px-4 py-3 text-ink focus:border-teal focus:outline-none" />
          </div>
        </div>

        <div>
          <label for="c-sujet" class="mb-2 block font-display text-[0.8rem] font-semibold uppercase tracking-wider text-ink">Sujet</label>
          <select id="c-sujet" name="sujet" class="w-full rounded-brand border border-line bg-cream px-4 py-3 text-ink focus:border-teal focus:outline-none">
            <option>Signaler une information périmée ou fausse</option>
            <option>Question sur un itinéraire</option>
            <option>Proposition de partenariat</option>
            <option>Demande presse</option>
            <option>Autre</option>
          </select>
        </div>

        <div>
          <label for="c-msg" class="mb-2 block font-display text-[0.8rem] font-semibold uppercase tracking-wider text-ink">Votre message</label>
          <textarea id="c-msg" name="message" rows="7" required
            class="w-full rounded-brand border border-line bg-cream px-4 py-3 text-ink focus:border-teal focus:outline-none"
            placeholder="Si vous signalez une erreur, indiquez la page et ce qui a changé — ça nous fait gagner beaucoup de temps."></textarea>
        </div>

        <!-- Piège à robots : un champ invisible que seuls les scripts remplissent. -->
        <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />

        <label class="flex items-start gap-3 text-[0.85rem] leading-relaxed text-warm">
          <input type="checkbox" name="rgpd" required class="mt-1 h-4 w-4 shrink-0 accent-teal" />
          <span>
            J'accepte que ces informations soient utilisées pour me répondre.
            Elles ne sont ni revendues ni utilisées à d'autres fins.
            <a href="/confidentialite" class="link">En savoir plus</a>.
          </span>
        </label>

        <div>
          <button type="submit" class="btn-primary">Envoyer le message</button>
          <p id="au-contact-msg" class="mt-4 hidden text-[0.88rem] text-teal-700" role="status"></p>
        </div>
      </form>
    </div>

    <aside class="space-y-6">
      <div class="rounded-brand border border-line bg-white p-6">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Par email</p>
        <a href={`mailto:${site.author.email}`} class="link mt-3 block font-display text-[1.05rem]">{site.author.email}</a>
        <p class="mt-3 text-[0.85rem] leading-relaxed text-warm">
          Le plus direct. Pour une correction, mettez l'URL de la page en objet.
        </p>
      </div>

      <div class="rounded-brand border border-line bg-white p-6">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-warm-light">Partenariats</p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-warm">
          Nous acceptons des collaborations à deux conditions : le service doit être testé au
          préalable, et la mention doit être visible pour le lecteur. Nous refusons les liens
          insérés dans du contenu existant et les articles rédigés par l'annonceur.
        </p>
      </div>

      <HorizonBand seed="contact-aside" variant="bande" accent="ink" class="!rounded-brand" />

      <div class="rounded-brand border-l-[3px] border-amber bg-amber-50 p-6">
        <p class="font-display text-[0.72rem] font-semibold uppercase tracking-[0.16em] text-amber-700">Ce qu'on ne peut pas faire</p>
        <p class="mt-3 text-[0.88rem] leading-relaxed text-ink-soft">
          Nous ne pouvons pas vérifier votre dossier de visa, ni vous garantir une décision
          consulaire. Pour tout ce qui est officiel, adressez-vous à l'ambassade concernée.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>

<script>
  const form = document.getElementById('au-contact') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    if (form.getAttribute('action')) return; // un backend est branché : on le laisse faire
    e.preventDefault();
    const msg = document.getElementById('au-contact-msg');
    if (msg) {
      msg.textContent =
        "Le formulaire n'est pas encore relié à un service d'envoi. Écrivez-nous directement à bonjour@asiaunseen.com — voir README, section « Brancher le formulaire ».";
      msg.classList.remove('hidden');
    }
  });
</script>
