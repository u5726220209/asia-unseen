---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';

/**
 * Le hub des guides anglais.
 *
 * Il ne déclare pas `/ressources` comme jumelle, et ce n'est pas un oubli. Le
 * hub français range onze guides, dont quatre qui n'auront jamais de version
 * anglaise : un comparatif d'assurances vendues en France, des cartes
 * bancaires françaises, un calendrier de renouvellement de passeport français.
 * Ces pages ne sont pas en retard de traduction, elles sont hors sujet pour un
 * lecteur anglophone — c'est écrit noir sur blanc dans `traduction.ts`.
 *
 * Déclarer les deux hubs jumeaux dirait donc à Google une chose fausse : que
 * l'un est la version de l'autre. Les guides, eux, se déclarent un par un,
 * parce que chacun a bien son original.
 */
const aujourdhui = new Date();
const guides = (await getCollection('guidesEn'))
  .filter((g) => !g.data.draft && g.data.pubDate <= aujourdhui)
  .sort((a, b) => (a.data.heading ?? a.data.title).localeCompare(b.data.heading ?? b.data.title, 'en'));
---

<BaseLayout
  title="Practical guides — travelling in Asia"
  description="Budget, season, transport, accommodation and the mistakes that cost the most: the guides that decide a trip to Asia, each with its sources."
  retourFr="/ressources"
  image="/og/en/guides-index.png"
  noindex={guides.length === 0}
>
  <header class="border-b border-line bg-cream-warm">
    <div class="wrap py-10 lg:py-14">
      <p class="eyebrow"><a href="/en" class="hover:text-teal">Asia Unseen</a></p>
      <h1 class="mt-5 max-w-3xl text-hero">The guides</h1>
      <p class="mt-6 max-w-2xl text-[1.15rem] leading-relaxed text-warm">
        The decisions that shape a trip to Asia — what it costs, when to go, how to move,
        where to sleep — each one with the source behind it and the month it was read.
      </p>
    </div>
  </header>

  <div class="wrap py-14">
    {guides.length === 0 && (
      <p class="py-20 text-center text-warm">
        The first English guides are on their way. In the meantime, the
        <a href="/en" class="link">country pages</a> give the entry rule for your passport.
      </p>
    )}

    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {guides.map((g) => (
        <ArticleCard
          langue="en"
          href={`/en/guides/${g.id}`}
          title={g.data.heading ?? g.data.title}
          accroche={g.data.accroche}
          meta={g.data.nature === 'editorial' ? 'Judgement' : 'Sourced'}
        />
      ))}
    </div>
  </div>
</BaseLayout>
