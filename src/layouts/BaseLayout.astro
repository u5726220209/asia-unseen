---
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@/styles/global.css';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import HeaderEn from '@/components/HeaderEn.astro';
import FooterEn from '@/components/FooterEn.astro';
import ExitIntent from '@/components/ExitIntent.astro';
import GoogleConsent from '@/components/GoogleConsent.astro';
import { LANGUES, langueDe, cheminEn } from '@/lib/langue';
import { site, legal } from '@/data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  /** Blocs JSON-LD supplémentaires propres à la page. */
  schema?: Record<string, unknown>[];
  /** Désactive la pop-up de sortie (pages légales, page de remerciement). */
  noPopup?: boolean;
  /**
   * Cette page existe-t-elle dans l'autre langue ?
   *
   * Faux par défaut, et c'est volontaire : tant que la traduction n'existe pas,
   * déclarer une jumelle serait envoyer Google sur un 404. On l'active page par
   * page, à mesure qu'elles sont réellement écrites.
   */
  traduite?: boolean;
  /**
   * L'adresse de la jumelle, quand les deux versions n'ont pas le même chemin.
   *
   * `traduite` suffit tant que la traduction vit à la même adresse préfixée —
   * `/vietnam` et `/en/vietnam`. Les articles, eux, ont deux slugs différents :
   * « où dormir à Hanoï » ne peut pas s'appeler `ou-dormir-a-hanoi` en anglais
   * sans perdre exactement les mots que l'on cherche à se faire trouver.
   *
   * Sans ce champ, ces pages-là ne déclaraient rien du tout. Ce n'était pas un
   * défaut visible : les deux versions existaient, chacune correcte, et le
   * contrôle de réciprocité les laissait passer puisqu'elles ne promettaient
   * rien. Mais Google voyait deux pages étrangères l'une à l'autre traitant le
   * même sujet — et c'est ainsi qu'une traduction se met à concurrencer son
   * original au lieu de le compléter.
   */
  jumelle?: string;
  /**
   * Où mène le bouton « Français », quand cette page n'a pas de jumelle.
   *
   * `jumelle` répond à deux questions à la fois, et elles ne coïncident pas
   * toujours. Le hub des guides anglais en est l'exemple : le bouton de langue
   * doit mener quelque part — `/ressources` — mais déclarer les deux hubs
   * jumeaux dirait à Google une chose fausse. Le hub français range onze
   * guides, dont quatre qui n'auront jamais de version anglaise parce qu'ils
   * documentent des assurances et des banques françaises. Ce n'est pas la même
   * page dans une autre langue.
   *
   * Sans ce champ, le bouton retirait `/en` du chemin et menait à `/guides`,
   * qui n'existe pas.
   */
  retourFr?: string;
  /**
   * La version lisible par machine de cette page.
   *
   * Le jeu de données existait, mais rien ne le reliait aux pages : un lecteur
   * automatique tombait sur de la prose française et devait deviner qu'un
   * fichier propre existait à une autre adresse. Ce lien est la manière
   * standard de le dire — et pour une fiche pays, il pointe vers ses données à
   * elle, pas vers le jeu complet où l'on ne saurait pas laquelle a servi.
   */
  donnees?: string;
}

const {
  title, description, image = '/og-default.png', type = 'website',
  publishedTime, modifiedTime, noindex = false, schema = [], noPopup = false,
  donnees, traduite = false, jumelle, retourFr,
} = Astro.props;

// Sur un déploiement de préversion, tout le site est en noindex : un sous-domaine
// temporaire indexé crée un doublon qui pénalise le domaine définitif au lancement.
const isPreview = import.meta.env.PUBLIC_NOINDEX === '1';
const blockIndexing = noindex || isPreview;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;

/**
 * Les deux versions de cette page, déclarées l'une à l'autre.
 *
 * `hreflang` dit à Google « cette page existe aussi là ». Une balise qui
 * pointerait vers une page absente serait pire que pas de balise : Google irait
 * la chercher, trouverait un 404, et douterait des autres. C'est pourquoi une
 * page ne déclare sa jumelle que si elle affirme l'avoir — `traduite` — et que
 * `verifier-config.mjs` refuse la mise en ligne si l'une des deux manque.
 */
const langue = langueDe(Astro.url.pathname);
const cheminCourant = Astro.url.pathname.replace(/\/$/, '') || '/';
const etiquetteDe = (code) => LANGUES.find((l) => l.code === code)!.etiquette;
const alternatives = jumelle
  ? [
      { code: langue, etiquette: etiquetteDe(langue), href: new URL(cheminCourant, site.url).href },
      {
        code: langue === 'fr' ? 'en' : 'fr',
        etiquette: etiquetteDe(langue === 'fr' ? 'en' : 'fr'),
        href: new URL(jumelle, site.url).href,
      },
    ]
  : traduite
    ? LANGUES.map((l) => ({
        code: l.code,
        etiquette: l.etiquette,
        href: new URL(cheminEn(Astro.url.pathname, l.code), site.url).href,
      }))
    : [];
const ogImage = new URL(image, site.url).href;
/**
 * Le nom du site n'est ajouté au titre que s'il tient dans la limite affichée
 * par Google, environ 60 caractères. Au-delà, la fin du titre est remplacée par
 * des points de suspension : ajouter la marque coûterait alors les mots qui
 * font cliquer, pour un gain nul — le nom de domaine est déjà affiché sous le
 * titre dans les résultats de recherche.
 */
const LIMITE_TITRE = 60;
const avecMarque = `${title} · ${site.name}`;
const fullTitle = title.includes(site.name)
  ? title
  : avecMarque.length <= LIMITE_TITRE
    ? avecMarque
    : title;

// Balisage global : l'organisation et le site, déclarés une fois sur chaque page.
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    inLanguage: 'fr-FR',
    description: site.description,
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    slogan: site.tagline,
    logo: { '@type': 'ImageObject', url: `${site.url}/brand/logo-primary.svg` },
    sameAs: Object.values(site.social),
    // L'identité légale est un signal d'entité fort : elle relie le site à une
    // personne réelle et immatriculée — ce qui compte sur des sujets où la
    // fiabilité est en jeu : formalités, argent, santé.
    legalName: `${legal.editeur} (${legal.enseigne})`,
    founder: { '@type': 'Person', name: legal.editeur },
    address: {
      '@type': 'PostalAddress',
      streetAddress: '60 rue François 1er',
      postalCode: '75008',
      addressLocality: 'Paris',
      addressCountry: 'FR',
    },
    identifier: [
      { '@type': 'PropertyValue', propertyID: 'SIREN', value: legal.siren.replace(/ /g, '') },
      { '@type': 'PropertyValue', propertyID: 'SIRET', value: legal.siret.replace(/ /g, '') },
    ],
    email: site.author.email,
  },
];
---

<!doctype html>
<html lang={langue} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternatives.map((a) => (
      <link rel="alternate" hreflang={a.etiquette} href={a.href} />
    ))}
    {alternatives.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={alternatives.find((a) => a.code === 'fr')!.href} />
    )}
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0A0A" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {/*
      Le fil annoncé est celui de la langue de la page. Servir le fil français
      en autodécouverte sur une page anglaise abonnerait le lecteur à vingt
      titres qu'il ne peut pas lire pour chaque titre qu'il peut.
    */}
    {langue === 'en' ? (
      <link rel="alternate" type="application/rss+xml" title={`${site.name} — latest in English`} href="/en/rss.xml" />
    ) : (
      <link rel="alternate" type="application/rss+xml" title={`${site.name} — derniers articles`} href="/rss.xml" />
    )}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — corrections`} href="/mises-a-jour/rss.xml" />
    {donnees && (
      <link rel="alternate" type="application/json" title="Les données de cette page, lisibles par machine" href={donnees} />
    )}

    {/*
      Vérification de propriété Search Console. Renseignez PUBLIC_GSC_TOKEN dans
      .env avec la valeur de la balise fournie par Google (la chaîne seule, pas
      la balise entière), puis republiez : la vérification passe sans toucher au DNS.
    */}
    {import.meta.env.PUBLIC_GSC_TOKEN && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GSC_TOKEN} />
    )}

    {[...baseSchema, ...schema].map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    {/*
      Consentement et scripts Google. Le Consent Mode est déclaré avant tout
      chargement, en refus par défaut là où le consentement est requis.
      Voir src/components/GoogleConsent.astro pour le raisonnement complet.
    */}
    <GoogleConsent />
  </head>

  <body class="flex min-h-screen flex-col">
    {/*
      Le lien d'évitement, dans la langue de la page.
      Il est invisible jusqu'au premier appui sur Tab, et c'est exactement ce
      qui l'a fait rester en français sur les neuf fiches anglaises : personne
      ne le voit. Personne, sauf ceux qui n'ont que lui — un lecteur d'écran
      annonçait « Aller au contenu » sur une page déclarée anglaise, donc dans
      une voix anglaise, donc inintelligible.
    */}
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-brand focus:bg-ink focus:px-5 focus:py-3 focus:font-display focus:text-sm focus:font-semibold focus:text-cream">
      {langue === 'en' ? 'Skip to content' : 'Aller au contenu'}
    </a>

    {/*
      Une page anglaise reçoit une navigation anglaise, pas la française
      traduite : celle-ci propose des guides et des articles qui n'existent
      qu'en français. Une navigation qui promet et ne tient pas est pire
      qu'une navigation courte.
    */}
    <div data-pagefind-ignore>{langue === 'en' ? <HeaderEn jumelle={jumelle ?? retourFr} /> : <Header />}</div>
    <main id="contenu" class="flex-1" data-pagefind-body><slot /></main>
    <div data-pagefind-ignore>{langue === 'en' ? <FooterEn /> : <Footer />}</div>
    {/*
      La pop-up de sortie est entièrement française : son titre, sa promesse,
      son bouton « S'inscrire », et la lettre qu'elle propose. Elle s'affichait
      pourtant sur les neuf fiches anglaises — une fenêtre en français, surgie
      sur une page anglaise, proposant une lettre que le lecteur ne pourra pas
      lire. C'est le pire moment pour se tromper de langue : elle interrompt.

      Le pied de page anglais avait pris cette décision dès le premier jour et
      l'avait écrite ; la pop-up, elle, n'était accrochée à aucune langue et
      personne n'y avait pensé. Elle reviendra le jour où une lettre anglaise
      existera.
    */}
    {!noPopup && langue === 'fr' && <ExitIntent />}

    <script>
      /*
       * Suivi des conversions, sans script tiers supplémentaire.
       *
       * Rien n'est envoyé tant que GA4 n'est pas configuré ET que le visiteur
       * n'a pas accepté les cookies : `gtag` n'existe simplement pas avant.
       *
       * Ces trois événements sont ceux vers lesquels une campagne payante doit
       * optimiser. Sans eux, un budget SEA s'ajuste à l'aveugle sur des clics
       * qui ne disent rien de ce qui se passe ensuite.
       */
      const envoi = (nom: string, params: Record<string, unknown>) => {
        const gtag = (window as any).gtag;
        if (typeof gtag === 'function') gtag('event', nom, { page_path: location.pathname, ...params });
      };

      // 1. Clic sortant vers un partenaire — la conversion qui rapporte.
      document.addEventListener('click', (e) => {
        const el = e.target as HTMLElement | null;

        const aff = el?.closest?.('a[data-aff]');
        if (aff) {
          envoi('affiliate_click', {
            partner: aff.getAttribute('data-aff'),
            link_url: aff.getAttribute('href'),
          });
          return;
        }

        // 2. Clic vers une source officielle — mesure la confiance accordée.
        const src = el?.closest?.('a[rel~="nofollow"][target="_blank"]');
        if (src && !src.hasAttribute('data-aff')) {
          const href = src.getAttribute('href') ?? '';
          if (/\.gov|diplomatie\.gouv\.fr|\.go\.(th|kr|jp|id)|mofa|immigration/.test(href)) {
            envoi('source_click', { link_url: href });
          }
        }
      });

      // 3. Inscription à la newsletter — la conversion qui construit l'actif.
      document.addEventListener('submit', (e) => {
        const form = e.target as HTMLFormElement | null;
        if (form?.classList.contains('au-nl')) {
          envoi('newsletter_submit', { form_variant: form.closest('section') ? 'block' : 'inline' });
        }
      });

      // 4. Usage réel d'un outil — le meilleur indicateur d'intention sur ce site.
      //    Un seul événement par outil et par page, à la première interaction.
      const outils = new Set<string>();
      document.addEventListener('input', (e) => {
        const cible = (e.target as HTMLElement)?.closest?.('.au-budget, .au-season, .au-checklist');
        if (!cible) return;
        const nom = cible.classList.contains('au-budget') ? 'budget'
                  : cible.classList.contains('au-season') ? 'saison'
                  : 'checklist';
        if (outils.has(nom)) return;
        outils.add(nom);
        envoi('tool_use', { tool: nom });
      }, true);
    </script>
  </body>
</html>
