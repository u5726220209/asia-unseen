---
import '@fontsource-variable/space-grotesk/wght.css';
import '@fontsource-variable/inter/wght.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-600.css';
import '@/styles/global.css';

import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ExitIntent from '@/components/ExitIntent.astro';
import ConsentBanner from '@/components/ConsentBanner.astro';
import { site, legal } from '@/data/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  /** Blocs JSON-LD supplémentaires propres à la page. */
  schema?: Record<string, unknown>[];
  /** Désactive la pop-up de sortie (pages légales, page de remerciement). */
  noPopup?: boolean;
}

const {
  title, description, image = '/og-default.png', type = 'website',
  publishedTime, modifiedTime, noindex = false, schema = [], noPopup = false,
} = Astro.props;

// Sur un déploiement de préversion, tout le site est en noindex : un sous-domaine
// temporaire indexé crée un doublon qui pénalise le domaine définitif au lancement.
const isPreview = import.meta.env.PUBLIC_NOINDEX === '1';
const blockIndexing = noindex || isPreview;

const canonical = new URL(Astro.url.pathname.replace(/\/$/, '') || '/', site.url).href;
const ogImage = new URL(image, site.url).href;
const fullTitle = title.includes(site.name) ? title : `${title} · ${site.name}`;

// Balisage global : l'organisation et le site, déclarés une fois sur chaque page.
const baseSchema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: site.name,
    url: site.url,
    inLanguage: 'fr-FR',
    description: site.description,
    publisher: { '@id': `${site.url}/#organization` },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    '@id': `${site.url}/#organization`,
    name: site.name,
    url: site.url,
    slogan: site.tagline,
    logo: { '@type': 'ImageObject', url: `${site.url}/brand/logo-primary.svg` },
    sameAs: Object.values(site.social),
    // L'identité légale est un signal d'entité fort : elle relie le site à une
    // personne réelle et immatriculée — ce qui compte sur des sujets où la
    // fiabilité est en jeu : formalités, argent, santé.
    legalName: `${legal.editeur} (${legal.enseigne})`,
    founder: { '@type': 'Person', name: legal.editeur },
    address: {
      '@type': 'PostalAddress',
      streetAddress: '60 rue François 1er',
      postalCode: '75008',
      addressLocality: 'Paris',
      addressCountry: 'FR',
    },
    identifier: [
      { '@type': 'PropertyValue', propertyID: 'SIREN', value: legal.siren.replace(/ /g, '') },
      { '@type': 'PropertyValue', propertyID: 'SIRET', value: legal.siret.replace(/ /g, '') },
    ],
    email: site.author.email,
  },
];
---

<!doctype html>
<html lang="fr" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {blockIndexing && <meta name="robots" content="noindex, nofollow" />}

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0A0A0A" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="alternate" type="application/rss+xml" title={`${site.name} — derniers articles`} href="/rss.xml" />

    {[...baseSchema, ...schema].map((s) => (
      <script type="application/ld+json" set:html={JSON.stringify(s)} />
    ))}

    {/*
      Aucun script tiers n'est chargé ici : GA4 et AdSense sont injectés par
      <ConsentBanner /> uniquement après un accord explicite du visiteur.
      Voir src/components/ConsentBanner.astro.
    */}
  </head>

  <body class="flex min-h-screen flex-col">
    <a href="#contenu" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-[100] focus:rounded-brand focus:bg-ink focus:px-5 focus:py-3 focus:font-display focus:text-sm focus:font-semibold focus:text-cream">
      Aller au contenu
    </a>

    <div data-pagefind-ignore><Header /></div>
    <main id="contenu" class="flex-1" data-pagefind-body><slot /></main>
    <div data-pagefind-ignore><Footer /></div>
    {!noPopup && <ExitIntent />}
    <ConsentBanner />

    <script>
      // Suivi des clics d'affiliation : permet de savoir quels liens convertissent
      // sans script tiers supplémentaire. N'envoie rien si GA4 n'est pas configuré.
      document.addEventListener('click', (e) => {
        const link = (e.target as HTMLElement)?.closest?.('a[data-aff]');
        if (!link) return;
        const partner = link.getAttribute('data-aff');
        const gtag = (window as any).gtag;
        if (typeof gtag === 'function') {
          gtag('event', 'affiliate_click', {
            partner,
            page_path: location.pathname,
            link_url: link.getAttribute('href'),
          });
        }
      });
    </script>
  </body>
</html>
