# ══════════════════════════════════════════════════════════════
# Asia Unseen — configuration Apache / LiteSpeed (Hostinger)
#
# Astro génère /page/index.html, mais les URL canoniques du site
# s'écrivent /page, sans slash final. Ces règles servent la bonne
# page sans redirection supplémentaire, et redirigent la variante
# avec slash pour éviter deux URL pour un même contenu.
#
# Sur Cloudflare Pages ou Vercel, ce fichier est ignoré : la
# configuration équivalente est dans public/_headers et vercel.json.
# ══════════════════════════════════════════════════════════════

Options -MultiViews
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # www → apex : une seule adresse indexée, alignée sur les canoniques.
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

  # /page/ → /page  (une seule URL canonique)
  RewriteCond %{REQUEST_URI} !^/$
  RewriteCond %{REQUEST_URI} (.+)/$
  RewriteRule ^ %1 [R=301,L]

  # /page → /page/index.html  (réécriture interne, sans redirection)
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]
</IfModule>

ErrorDocument 404 /404/index.html

# ── Sécurité ──────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"

  # Les assets versionnés d'Astro sont immuables.
  <FilesMatch "\.(js|css|woff2|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>

# ── Compression ───────────────────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml \
    application/javascript application/json image/svg+xml
</IfModule>
