# Copiez ce fichier en `.env` et remplissez les valeurs avant la mise en production.
# Toutes ces variables sont OPTIONNELLES : le site se construit et fonctionne sans elles.
# Tant qu'une valeur est vide, le bloc correspondant n'est simplement pas rendu.

# --- Référencement ---
PUBLIC_GSC_TOKEN=              # jeton de vérification Google Search Console
PUBLIC_SITE_URL=               # ne renseigner que pour un déploiement hors asiaunseen.com

# --- Analytics ---
PUBLIC_GA4_ID=

# --- Monétisation display ---
PUBLIC_ADSENSE_CLIENT=          # ex: ca-pub-1234567890123456
PUBLIC_ADSENSE_SLOT_IN_ARTICLE=
PUBLIC_ADSENSE_SLOT_IN_FEED=
PUBLIC_ADSENSE_SLOT_SIDEBAR=

# --- Affiliation (identifiants partenaires) ---
PUBLIC_AFF_BOOKING=             # aid=...
PUBLIC_AFF_AGODA=
PUBLIC_AFF_12GO=
PUBLIC_AFF_GETYOURGUIDE=
PUBLIC_AFF_AIRALO=
PUBLIC_AFF_HOLAFLY=
PUBLIC_AFF_CHAPKA=
PUBLIC_AFF_WISE=

# --- Newsletter (endpoint du formulaire) ---
PUBLIC_NEWSLETTER_ENDPOINT=     # ex: https://app.convertkit.com/forms/XXXX/subscriptions
